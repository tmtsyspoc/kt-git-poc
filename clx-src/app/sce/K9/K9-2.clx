        <cl:output std:sid="output-8ad6c93d" id="opt2_2" class="tit" value="중복 요청 방지 및 재시도 통제">
          <cl:verticaldata std:sid="v-data-24a3b0eb" width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-f588f595" id="opt5" class="txt" displayexp="&quot;버튼 연속 클릭은 &quot; + sstr(&quot;서브미션 전송 상태 확인&quot;, [&quot;fw-bold&quot;]) + &quot;으로 제어하여 요청을 1회만 전송합니다.&quot; + &quot;\n\r&quot; + &quot;새로고침이나 네트워크 재시도로 동일한 요청이 다시 발생해도 &quot; + sstr(&quot;거래 고유키&quot;, [&quot;fw-bold&quot;]) + &quot;로 이미 처리된 거래인지 판별하여 거래가 한 번만 처리되도록 통제합니다.&quot;">
          <cl:verticaldata std:sid="v-data-f2af1b87" width="1218px" height="54px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-cf7ba67b" scrollable="false" spacing="8"/>
      </cl:group>
