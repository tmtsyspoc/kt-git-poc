          </cl:button>
          <cl:formlayout std:sid="f-layout-275884fc" scrollable="false" hspace="4px" vspace="4px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="105" unit="PIXEL" autoSizing="false" syncminlength="true"/>
            <cl:columns length="1" unit="FRACTION" shadetype="NONE" shadecolor="transparent"/>
          </cl:formlayout>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-cf7ba67b" scrollable="false" spacing="8"/>
