        <cl:output std:sid="output-8ad6c93d" id="opt2_2" class="tit" value="서브미션 단위 API 장애 격리">
          <cl:verticaldata std:sid="v-data-24a3b0eb" width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-f588f595" id="opt5" class="txt" displayexp="&quot;eXBuilder6는 서버 통신을 &quot; + sstr(&quot;서브미션 단위로 독립 처리&quot;, [&quot;fw-bold&quot;]) + &quot;하여 Timeout, 4xx, 5xx 오류나 일부 API만 실패하는 부분실패가 발생해도 그 영향을 해당 영역으로 격리합니다. 실패한 영역에는 오류 상태와 재시도를 제공하고, 정상 응답을 받은 영역과 화면의 나머지 기능은 그대로 사용할 수 있습니다.&quot;">
          <cl:verticaldata std:sid="v-data-f2af1b87" width="1218px" height="54px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-fa480841" id="grp2_2" visible="false">
          <cl:verticaldata std:sid="v-data-9733b5a4" width="1550px" height="28px" autosize="none"/>
