    <screen std:sid="screen-4e8d2e60" id="mobile" name="mobile" width="0px" height="767px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <cl:model std:sid="model-b28ed320">
      <cl:dataset comment="프로세스 목록" std:sid="d-set-699236e9" id="dsProcess">
        <cl:datacolumnlist>
          <cl:datacolumn comment="" std:sid="d-column-3be520a9" name="TITLE"/>
          <cl:datacolumn std:sid="d-column-a104e4c9" name="TITLE_RIGHT_TEXT"/>
          <cl:datacolumn comment="" std:sid="d-column-da5085d3" name="SUB_TITLE"/>
          <cl:datacolumn comment="" std:sid="d-column-0ed73719" name="DELIMITER" datatype="string"/>
