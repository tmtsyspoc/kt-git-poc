  <body std:sid="body-b8179661" class="wrap">
    <cl:listener name="init" handler="onBodyInit2"/>
    <cl:listener name="load" handler="onBodyLoad"/>
    <cl:udc std:sid="ud-control-d666de8b" type="udc.com.udcComAppHeader">
      <cl:verticaldata std:sid="v-data-ad6320bc" width="900px" height="28px"/>
    </cl:udc>
    <cl:group id="grpData" class="conts-area">
      <cl:verticaldata width="976px" height="903px" autosize="none" grow="1"/>
      <cl:tabfolder id="tabMain" class="conts-area" headerarrowposition="both">
        <cl:listener name="selection-change" handler="onTabMainSelectionChange"/>
        <cl:verticaldata width="100px" height="100%" autosize="none" grow="1"/>
        <cl:tabitem selected="true" text="요구사항 설명">
          <std:metadata>
            <std:property key="is-active-item" value="true"/>
          </std:metadata>
          <cl:group id="grpTab1" class="conts-area">
            <cl:group class="conts-wrap">
              <cl:verticaldata width="976px" height="670px" autosize="height"/>
              <cl:udc id="udcPocDocViewer1" type="udc.poc.udcPocDocViewer">
                <cl:verticaldata width="500px" height="620px" autosize="height"/>
                <cl:property name="fileUrl" value="../A12/data/docs/A12-1.png" type="resource"/>
              </cl:udc>
              <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
            </cl:group>
            <cl:verticallayout spacing="16"/>
          </cl:group>
        </cl:tabitem>
        <cl:tabitem text="키보드 업무 시연">
          <cl:group id="grpTab2" class="conts-area">
            <cl:group id="grpGoverning" class="governing">
              <cl:verticaldata width="992px" height="80px" autosize="height"/>
              <cl:output id="optGovTit" class="tit" value="포커스 원복 시연">
                <cl:verticaldata width="100px" height="28px" autosize="height"/>
              </cl:output>
              <cl:output id="optGovTxt" class="txt" value="입력 후 탭 이동·팝업·오류·화면 전환을 해도 직전에 작업하던 컨트롤로 포커스가 돌아옵니다. Tab/Shift+Tab/Enter로 이동하며 확인하세요.">
                <cl:verticaldata width="1218px" height="31px" autosize="height"/>
              </cl:output>
              <cl:verticallayout scrollable="false" spacing="8"/>
            </cl:group>
            <cl:group id="grpSearch" class="sch-filter-box">
              <cl:verticaldata width="976px" height="96px" autosize="height"/>
              <cl:output id="optSch1" class="label" value="고객명">
                <cl:formdata row="0" col="0"/>
              </cl:output>
              <cl:inputbox id="ipbSchName" placeholder="고객명 입력">
                <cl:listener name="keydown" handler="onIpbSchNameKeydown"/>
                <cl:formdata row="0" col="1"/>
              </cl:inputbox>
              <cl:output id="optSch2" class="label" value="요금제">
                <cl:formdata row="0" col="2"/>
              </cl:output>
              <cl:combobox id="cmbSchType" value="">
                <cl:formdata row="0" col="3"/>
                <cl:item label="전체" value=""/>
                <cl:item label="프리미엄" value="P"/>
                <cl:item label="일반" value="G"/>
                <cl:item label="절약형" value="S"/>
              </cl:combobox>
              <cl:output id="optSch3" class="label" value="가입일">
                <cl:formdata row="0" col="4"/>
              </cl:output>
              <cl:group id="grpSchDate" class="form-control">
                <cl:formdata row="0" col="5"/>
                <cl:dateinput id="dtiSchFrom">
                  <cl:formdata row="0" col="0"/>
                </cl:dateinput>
                <cl:output id="optSchTilde" value="~">
                  <cl:formdata row="0" col="1"/>
                </cl:output>
                <cl:dateinput id="dtiSchTo">
                  <cl:formdata row="0" col="2"/>
                </cl:dateinput>
                <cl:formlayout scrollable="false" hspace="4px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                  <cl:rows length="1" unit="FRACTION"/>
                  <cl:columns length="1" unit="FRACTION"/>
                  <cl:columns length="10" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
                  <cl:columns length="1" unit="FRACTION"/>
                </cl:formlayout>
              </cl:group>
              <cl:output id="optSch4" class="label" value="사용여부">
                <cl:formdata row="1" col="0"/>
              </cl:output>
              <cl:radiobutton id="rdbSchUse" value="">
                <cl:formdata row="1" col="1"/>
                <cl:item label="전체" value=""/>
                <cl:item label="사용" value="Y"/>
                <cl:item label="미사용" value="N"/>
              </cl:radiobutton>
              <cl:button id="btnReset" value="초기화">
                <cl:listener name="click" handler="onBtnResetClick"/>
                <cl:formdata row="1" col="6"/>
              </cl:button>
              <cl:button id="btnSearch" class="primary btn-search" value="조회" icon="0">
                <cl:listener name="click" handler="onBtnSearchClick"/>
                <cl:formdata row="1" col="7"/>
              </cl:button>
              <cl:formlayout scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="28" unit="PIXEL" autoSizing="false"/>
                <cl:rows length="28" unit="PIXEL" autoSizing="false"/>
                <cl:columns length="80" autoSizing="true"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="80" autoSizing="true"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="80" autoSizing="true"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="80" unit="PIXEL" autoSizing="true" syncminlength="false"/>
                <cl:columns length="70" unit="PIXEL" autoSizing="true" syncminlength="false"/>
              </cl:formlayout>
            </cl:group>
            <cl:group id="grpList" class="conts-wrap">
              <cl:verticaldata width="976px" height="300px" autosize="height"/>
              <cl:udc id="udcComGridTitle1" type="udc.com.udcComGridTitle">
                <cl:verticaldata width="800px" height="28px" autosize="height"/>
                <cl:property name="title" value="고객 목록" type="string"/>
                <cl:property name="ctrl" value="grdList" type="control"/>
                <cl:property name="showExportExcel" value="false" type="boolean"/>
                <cl:property name="showOption" value="false" type="boolean"/>
                <cl:property name="showPivot" value="false" type="boolean"/>
              </cl:udc>
              <cl:grid id="grdList" fieldLabel="고객 목록" datasetid="dsList" clickmode="select">
                <cl:listener name="selection-change" handler="onGrdListSelectionChange"/>
                <cl:verticaldata width="400px" height="200px"/>
                <cl:gridcolumn width="70px"/>
                <cl:gridcolumn width="140px"/>
                <cl:gridcolumn width="120px"/>
                <cl:gridcolumn width="120px"/>
                <cl:gridcolumn width="120px"/>
                <cl:gridcolumn width="80px"/>
                <cl:gridheader>
                  <cl:gridrow height="36px"/>
                  <cl:gridcell rowindex="0" colindex="0" text="번호"/>
                  <cl:gridcell rowindex="0" colindex="1" text="고객명"/>
                  <cl:gridcell rowindex="0" colindex="2" text="요금제"/>
                  <cl:gridcell rowindex="0" colindex="3" text="가입일"/>
                  <cl:gridcell rowindex="0" colindex="4" text="월요금"/>
                  <cl:gridcell rowindex="0" colindex="5" text="사용여부"/>
                </cl:gridheader>
                <cl:griddetail>
                  <cl:gridrow height="36px"/>
                  <cl:gridcell rowindex="0" colindex="0" columnname="ID">
                    <cl:output id="optGrdId" style="text-align:center;">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                  <cl:gridcell rowindex="0" colindex="1" columnname="NAME">
                    <cl:output id="optGrdName">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                  <cl:gridcell rowindex="0" colindex="2" columnname="TYPE">
                    <cl:output id="optGrdType" style="text-align:center;">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                  <cl:gridcell rowindex="0" colindex="3" columnname="JOIN_DT">
                    <cl:output id="optGrdJoin" style="text-align:center;" datatype="date" format="YYYY-MM-DD">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                  <cl:gridcell rowindex="0" colindex="4" columnname="AMT">
                    <cl:output id="optGrdAmt" class="text-right" datatype="number" format="s#,##0">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                  <cl:gridcell rowindex="0" colindex="5" columnname="USE_YN">
                    <cl:output id="optGrdUse" style="text-align:center;">
                      <cl:celldata/>
                    </cl:output>
                  </cl:gridcell>
                </cl:griddetail>
              </cl:grid>
              <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
            </cl:group>
            <cl:group id="grpForm" class="conts-wrap">
              <cl:verticaldata width="976px" height="400px" autosize="height"/>
              <cl:udc id="udcComFormTitle3" type="udc.com.udcComFormTitle">
                <cl:verticaldata width="800px" height="28px" autosize="height"/>
                <cl:property name="title" value="고객 상세" type="string"/>
              </cl:udc>
              <cl:group id="grpFormBody" class="form">
                <cl:verticaldata width="972px" height="230px" autosize="height"/>
                <cl:output id="optF1" class="label required" value="고객명">
                  <cl:formdata row="0" col="0"/>
                </cl:output>
                <cl:inputbox id="ipbName" maxlength="20">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="NAME"/>
                  <cl:formdata row="0" col="1"/>
                </cl:inputbox>
                <cl:output id="optF2" class="label" value="연락처">
                  <cl:formdata row="0" col="2"/>
                </cl:output>
                <cl:inputbox id="ipbTel" maxlength="13" placeholder="010-0000-0000">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="TEL"/>
                  <cl:formdata row="0" col="3"/>
                </cl:inputbox>
                <cl:output id="optF3" class="label required" value="요금제">
                  <cl:formdata row="1" col="0"/>
                </cl:output>
                <cl:combobox id="cmbType">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="TYPE"/>
                  <cl:formdata row="1" col="1"/>
                  <cl:item label="선택" value=""/>
                  <cl:item label="프리미엄" value="P"/>
                  <cl:item label="일반" value="G"/>
                  <cl:item label="절약형" value="S"/>
                </cl:combobox>
                <cl:output id="optF4" class="label" value="가입일">
                  <cl:formdata row="1" col="2"/>
                </cl:output>
                <cl:dateinput id="dtiJoin">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="JOIN_DT"/>
                  <cl:formdata row="1" col="3"/>
                </cl:dateinput>
                <cl:output id="optF5" class="label" value="월요금">
                  <cl:formdata row="2" col="0"/>
                </cl:output>
                <cl:numbereditor id="nbeAmt" spinbutton="true">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="AMT"/>
                  <cl:formdata row="2" col="1"/>
                </cl:numbereditor>
                <cl:output id="optF6" class="label" value="사용여부">
                  <cl:formdata row="2" col="2"/>
                </cl:output>
                <cl:radiobutton id="rdbUse" value="Y">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="USE_YN"/>
                  <cl:formdata row="2" col="3"/>
                  <cl:item label="사용" value="Y"/>
                  <cl:item label="미사용" value="N"/>
                </cl:radiobutton>
                <cl:output id="optF7" class="label" value="부가서비스">
                  <cl:formdata row="3" col="0"/>
                </cl:output>
                <cl:checkboxgroup id="cbgOpt">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="OPTS"/>
                  <cl:formdata row="3" col="1" rowspan="1" colspan="3"/>
                  <cl:item label="로밍" value="S1"/>
                  <cl:item label="데이터 쉐어링" value="S2"/>
                  <cl:item label="단말보험" value="S3"/>
                </cl:checkboxgroup>
                <cl:output id="optF8" class="label" value="메모">
                  <cl:formdata row="4" col="0"/>
                </cl:output>
                <cl:textarea id="txaMemo">
                  <cl:datamapbind property="value" datacontrolid="dmForm" columnname="MEMO"/>
                  <cl:formdata row="4" col="1" rowspan="1" colspan="3"/>
                </cl:textarea>
                <cl:formlayout scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
                  <cl:rows length="28" unit="PIXEL"/>
                  <cl:rows length="28" unit="PIXEL"/>
                  <cl:rows length="28" unit="PIXEL"/>
                  <cl:rows length="28" unit="PIXEL"/>
                  <cl:rows length="70" unit="PIXEL"/>
                  <cl:columns length="120" unit="PIXEL" shadetype="BY_CLASS"/>
                  <cl:columns length="1" unit="FRACTION"/>
                  <cl:columns length="120" unit="PIXEL" shadetype="BY_CLASS"/>
                  <cl:columns length="1" unit="FRACTION"/>
                </cl:formlayout>
              </cl:group>
              <cl:group id="grpFormBtns">
                <cl:verticaldata width="972px" height="28px" autosize="height"/>
                <cl:button id="btnNew" value="신규">
                  <cl:listener name="click" handler="onBtnNewClick"/>
                  <cl:flowlayoutdata width="80px" height="28px" autosize="none"/>
                </cl:button>
                <cl:button id="btnSave" class="primary" value="저장">
                  <cl:listener name="click" handler="onBtnSaveClick"/>
                  <cl:flowlayoutdata width="80px" height="28px" autosize="none"/>
                </cl:button>
                <cl:button id="btnPopup" value="팝업 확인">
                  <cl:listener name="click" handler="onBtnPopupClick"/>
                  <cl:flowlayoutdata width="100px" height="28px" autosize="none"/>
                </cl:button>
                <cl:button id="btnError" value="오류 발생">
                  <cl:listener name="click" handler="onBtnErrorClick"/>
                  <cl:flowlayoutdata width="100px" height="28px" autosize="none"/>
                </cl:button>
                <cl:button id="btnSwitch" value="화면 전환">
                  <cl:listener name="click" handler="onBtnSwitchClick"/>
                  <cl:flowlayoutdata width="100px" height="28px" autosize="none"/>
                </cl:button>
                <cl:flowlayout hspacing="4" halign="right"/>
              </cl:group>
              <cl:output id="optFocusInfo" class="txt" value="포커스 기록: -">
                <cl:verticaldata width="972px" height="28px" autosize="height"/>
              </cl:output>
              <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
            </cl:group>
            <cl:verticallayout spacing="16"/>
          </cl:group>
        </cl:tabitem>
      </cl:tabfolder>
      <cl:verticallayout spacing="16" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-92cc3d8a" spacing="16" leftmargin="24" rightmargin="24" topmargin="16" bottommargin="24"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>
