<cl:tabitem text="고대비 및 색약 모드">
<cl:group id="grpTab2" class="conts-area">
      
      <cl:group id="grpGoverning" class="governing">
        <cl:verticaldata width="992px" height="124px" autosize="height"/>
        <cl:output id="opt2_2" class="tit" value="다양한 테마 변경">
          <cl:verticaldata width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output id="opt5_2" class="txt" value="다양한 테마 및 고대비, 색상 필터를 적용하여 다양한 사용자로부터 접근성을 높힐 수 있습니다.">
          <cl:verticaldata width="1218px" height="54px" autosize="height"/>
        </cl:output>
        <cl:verticallayout scrollable="false" spacing="8"/>
      </cl:group>
      <cl:group id="grp2_2" class="conts-wrap">
        <std:metadata>
          <std:property key="template-uuid" value="f91b19be-4854-4d7d-b7e1-c43b9a18b816"/>
          <std:property key="template-rev" value="5"/>
        </std:metadata>
        <cl:verticaldata width="992px" height="174px" autosize="height"/>
        <cl:group id="grp4_2" class="form _setting">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata width="992px" height="140px" autosize="height"/>
          <cl:group class="setting-list p-0" clipcontent="false">
            <cl:formdata row="0" col="1" rowspan="1" colspan="1"/>
            <cl:group class="li" clipcontent="false">
              <cl:xylayoutdata left="0px" width="810px" height="30px" horizontalAnchor="LEFT" verticalAnchor="CENTER"/>
              <cl:radiobutton id="rdbColor" class="color-set v2" value="orange-theme" colcount="-1" fixedwidth="true" hspacing="8" vspacing="0" clickRegion="item">
                <cl:listener name="selection-change" handler="onRdbColorSelectionChange"/>
                <cl:flowlayoutdata width="159px" height="100%" autosize="none"/>
                <cl:item label="기본" value="default">
                  <cl:expbind property="tooltip" category="PROPERTY" expression="label"/>
                </cl:item>
                <cl:item label="보라" value="purple-theme">
                  <cl:expbind property="tooltip" category="PROPERTY" expression="label"/>
                </cl:item>
                <cl:item label="초록" value="green-theme">
                  <cl:expbind property="tooltip" category="PROPERTY" expression="label"/>
                </cl:item>
                <cl:item label="주황" value="orange-theme">
                  <cl:expbind property="tooltip" category="PROPERTY" expression="label"/>
                </cl:item>
                <cl:item label="빨강" value="red-theme">
                  <cl:expbind property="tooltip" category="PROPERTY" expression="label"/>
                </cl:item>
                <cl:itemstyle>
                  <cl:expbind property="class" category="CLASS" expression="value"/>
                </cl:itemstyle>
              </cl:radiobutton>
              <cl:flowlayout/>
            </cl:group>
            <cl:xylayout/>
          </cl:group>
          <cl:output id="opt3_2" class="label" value="테마">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:output id="opt4_2" class="label" value="고대비">
            <cl:formdata row="1" col="0"/>
          </cl:output>
          <cl:checkbox id="cbx3" text="">
            <cl:listener name="value-change" handler="onCbx3ValueChange"/>
            <cl:formdata row="1" col="1"/>
          </cl:checkbox>
          <cl:output id="opt6_2" class="label" value="색상 필터">
            <cl:formdata row="2" col="0"/>
          </cl:output>
          <cl:checkbox id="cbx1" text="">
            <cl:listener name="value-change" handler="onCbx1ValueChange"/>
            <cl:formdata row="2" col="1"/>
          </cl:checkbox>
          <cl:formlayout scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
            <cl:rows length="32" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="true"/>
            <cl:rows length="28" unit="PIXEL" autoSizing="true"/>
            <cl:rows length="28" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="100" unit="PIXEL" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
      </cl:group>
      <cl:verticallayout spacing="16"/>
    </cl:group>
</cl:tabitem>
<cl:tabitem text="원그리드 예제">
<cl:group id="grpTab3" class="conts-area">
      <cl:group id="grpOneSearch" class="sch-filter-box">
        <cl:verticaldata width="976px" height="44px" autosize="height"/>
        <cl:output id="optOneS1" class="label" value="품목명">
          <cl:formdata row="0" col="0"/>
        </cl:output>
        <cl:inputbox id="ipbOneSchName" placeholder="품목명 입력">
          <cl:listener name="keydown" handler="onIpbOneSchNameKeydown"/>
          <cl:formdata row="0" col="1"/>
        </cl:inputbox>
        <cl:output id="optOneS2" class="label" value="구분">
          <cl:formdata row="0" col="2"/>
        </cl:output>
        <cl:combobox id="cmbOneSchType" value="">
          <cl:formdata row="0" col="3"/>
          <cl:item label="전체" value=""/>
          <cl:item label="단말" value="D"/>
          <cl:item label="요금제" value="P"/>
          <cl:item label="부가서비스" value="S"/>
        </cl:combobox>
        <cl:button id="btnOneSearch" class="primary btn-search" value="조회" icon="0">
          <cl:listener name="click" handler="onBtnOneSearchClick"/>
          <cl:formdata row="0" col="5"/>
        </cl:button>
        <cl:formlayout scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="28" unit="PIXEL" autoSizing="false"/>
          <cl:columns length="80" autoSizing="true"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="80" autoSizing="true"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="70" unit="PIXEL" autoSizing="true" syncminlength="false"/>
        </cl:formlayout>
      </cl:group>
      <cl:group id="grpOneCont" class="conts-wrap">
        <cl:verticaldata width="976px" height="560px" autosize="none" grow="1"/>
        <cl:group id="grpOneTitle">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata width="972px" height="28px" autosize="height"/>
          <cl:udc id="udcComGridTitleOne" type="udc.com.udcComGridTitle">
            <cl:formdata row="0" col="0"/>
            <cl:property name="title" value="품목 목록" type="string"/>
            <cl:property name="ctrl" value="grdOne" type="control"/>
          </cl:udc>
          <cl:group id="grpOneBtns">
            <cl:formdata row="0" col="1"/>
            <cl:udc id="udcComGridCudBtnsOne" type="udc.com.udcComGridCudBtns">
              <cl:listener name="save" handler="onUdcComGridCudBtnsOneSave"/>
              <cl:flowlayoutdata width="345px" height="28px" autosize="both"/>
              <cl:property name="grid" value="grdOne" type="control"/>
              <cl:property name="focusColumnName" value="ITEM_NM" type="string"/>
            </cl:udc>
            <cl:flowlayout halign="right"/>
          </cl:group>
          <cl:formlayout scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="453" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid id="grdOne" fieldLabel="품목 목록" datasetid="dsOne" clickmode="edit">
          <cl:verticaldata width="972px" height="480px" autosize="none" grow="1"/>
          <cl:gridcolumn width="60px"/>
          <cl:gridcolumn width="1fr"/>
          <cl:gridcolumn width="140px"/>
          <cl:gridcolumn width="140px"/>
          <cl:gridcolumn width="120px"/>
          <cl:gridcolumn width="120px"/>
          <cl:gridheader>
            <cl:gridrow height="36px"/>
            <cl:gridcell rowindex="0" colindex="0" text="번호"/>
            <cl:gridcell rowindex="0" colindex="1" text="품목명"/>
            <cl:gridcell rowindex="0" colindex="2" text="구분"/>
            <cl:gridcell rowindex="0" colindex="3" text="단가"/>
            <cl:gridcell rowindex="0" colindex="4" text="재고수량"/>
            <cl:gridcell rowindex="0" colindex="5" text="등록일"/>
          </cl:gridheader>
          <cl:griddetail>
            <cl:gridrow height="36px"/>
            <cl:gridcell rowindex="0" colindex="0">
              <cl:output id="optOneNo" style="text-align:center;">
                <cl:expbind property="value" category="PROPERTY" expression="getIndex() + 1"/>
                <cl:celldata/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell rowindex="0" colindex="1" columnname="ITEM_NM">
              <cl:inputbox id="ipbOneNm" maxlength="30">
                <cl:celldata/>
              </cl:inputbox>
            </cl:gridcell>
            <cl:gridcell rowindex="0" colindex="2" columnname="ITEM_TYPE">
              <cl:combobox id="cmbOneType">
                <cl:celldata/>
                <cl:item label="단말" value="D"/>
                <cl:item label="요금제" value="P"/>
                <cl:item label="부가서비스" value="S"/>
              </cl:combobox>
            </cl:gridcell>
            <cl:gridcell rowindex="0" colindex="3" columnname="PRICE">
              <cl:numbereditor id="nbeOnePrice" format="s#,##0">
                <cl:celldata/>
              </cl:numbereditor>
            </cl:gridcell>
            <cl:gridcell rowindex="0" colindex="4" columnname="STOCK">
              <cl:numbereditor id="nbeOneStock" format="s#,##0">
                <cl:celldata/>
              </cl:numbereditor>
            </cl:gridcell>
            <cl:gridcell rowindex="0" colindex="5" columnname="REG_DT">
              <cl:dateinput id="dtiOneReg">
                <cl:celldata/>
              </cl:dateinput>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
      </cl:group>
      <cl:verticallayout spacing="16"/>
    </cl:group>
</cl:tabitem>
</cl:tabfolder>
<cl:verticallayout spacing="16" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
</cl:group>
    <cl:verticallayout std:sid="v-layout-89585e47" spacing="16" leftmargin="24" rightmargin="24" topmargin="16" bottommargin="24"/>
  </body>
