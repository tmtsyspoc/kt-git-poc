<cl:tabitem text="반응형 디자인">
<cl:group id="grpTab2" class="conts-area">
      
      <cl:group id="grpGoverning" class="governing">
        <cl:verticaldata width="992px" height="164px" autosize="height"/>
        <cl:output id="opt18" class="tit" value="반응형 디자인">
          <cl:verticaldata width="100px" height="33px" autosize="height"/>
        </cl:output>
        <cl:output id="opt19" class="txt" displayexp="&quot;사용자 화면에 맞춰 UI컨트롤의 배치 자동변경 및 텍스트가 줄바꿈되는 &quot;+sstr(&quot;반응형 웹 특화 전용 레이아웃&quot;, [&quot;font-bold&quot;])+&quot;을 기본 제공하여, 한개의 화면 소스로 다양한 해상도에 최적화 된 UI를 제공합니다.\n&quot;&#xD;&#xA;+&quot;이를 통해 반응형 웹 화면 개발 시 &quot;+sstr(&quot;생산성은 향상&quot;, [&quot;font-bold&quot;])+&quot;되며,  해당도별 관리 포인트를 절감하여 &quot;+sstr(&quot;운영 효율성 또한 향상&quot;, [&quot;font-bold&quot;])+&quot;됩니다.&quot;">
          <cl:verticaldata width="1218px" height="89px" autosize="height"/>
        </cl:output>
        <cl:verticallayout scrollable="false" spacing="8"/>
      </cl:group>
      <cl:group class="conts-area">
        <cl:verticaldata width="1592px" height="998px" autosize="height"/>
        <cl:tabfolder id="tab" item-spacing="5">
          <cl:verticaldata width="992px" height="998px" autosize="height"/>
          <cl:tabitem text="반응형 레이아웃" visible="false">
            <cl:group id="grp18">
              <std:metadata>
                <std:property key="locked" value="true"/>
              </std:metadata>
              <cl:group class="conts-wrap">
                <cl:verticaldata width="1592px" height="618px" autosize="height"/>
                <cl:group id="grp10">
                  <cl:verticaldata width="1558px" height="134px" autosize="height"/>
                  <cl:udc id="udcComFormTitle3" type="udc.com.udcComFormTitle">
                    <cl:verticaldata width="800px" height="28px" autosize="height"/>
                    <cl:property name="title" value="반응형 레이아웃" type="string"/>
                  </cl:udc>
                  <cl:output id="opt9" value="eXBuilder6 에서 제공하는 5개의 레이아웃 중 반응형에 최적화 되어 있는 두 가지 레이아웃을 제공합니다.">
                    <cl:verticaldata width="1250px" height="18px" autosize="height"/>
                  </cl:output>
                  <cl:verticallayout spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
