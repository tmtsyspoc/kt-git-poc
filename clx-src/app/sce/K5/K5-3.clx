      <cl:tabitem std:sid="t-item-1cf89229" text="개발산출물 자동완성">
        <cl:group std:sid="group-5d5ba976" id="grpTab3" class="conts-area">
          <cl:group std:sid="group-4b70d895" id="grpGoverning_2" class="governing">
            <cl:verticaldata std:sid="v-data-c28b8a9d" width="992px" height="140px" autosize="height"/>
            <cl:output std:sid="output-0bb9eecf" id="opt8" class="tit" value="개발산출물 자동완성 기능">
              <cl:verticaldata std:sid="v-data-8117f4d6" width="100px" height="36px" autosize="height"/>
            </cl:output>
            <cl:output std:sid="output-37cee353" id="opt9" class="txt" displayexp="&quot;eXBuilder6로 작성된 UI(화면)는 화면 설계서 및 개발산출물 등의 &quot; + sstr(&quot;문서 작업으로 소요되는 시간을 절감&quot;, [&quot;fw-bold&quot;]) + &quot;할 수 있도록 &quot;+  sstr(&quot;화면 설계 정의서 자동 생성&quot;, [&quot;fw-bold&quot;, &quot;text-red&quot;]) + &quot;기능을 제공하고 있습니다.&quot; + &quot;\n\r&quot; +sstr(&quot;설계된 화면은 이벤트만 추가하여 바로 개발&quot;, [&quot;fw-bold&quot;])+&quot;할 수 있어 &quot;+ sstr(&quot;프로젝트 생산성을 향상&quot;, [&quot;fw-bold&quot;]) + &quot;시킬 수 있습니다.&quot;&#xD;&#xA;&#xD;&#xA;">
              <cl:verticaldata std:sid="v-data-575f265c" width="1218px" height="54px" autosize="height"/>
            </cl:output>
            <cl:verticallayout std:sid="v-layout-27926a88" scrollable="false" spacing="8"/>
          </cl:group>
          <cl:group comment="결제일문의" std:sid="group-62f531ba" id="grpSearch" class="sch-filter-box">
            <cl:attribute name="mobile-column-count" value="3"/>
            <cl:verticaldata std:sid="v-data-e8e70401" width="1080px" height="61px" autosize="height"/>
            <cl:output std:sid="output-99f0b6c0" id="opt1" class="label required" value="고객번호">
              <cl:formdata std:sid="f-data-7ea6a901" row="0" col="0"/>
            </cl:output>
            <cl:udc comment="&lt;R>E-NAME: 고객번호 변경 이벤트&#xD;&#xA;&lt;R>E-DOC: 고객검색 팝업 호출&#xD;&#xA;&lt;R>E-PARAM: CUST_NO:고객번호&#xD;&#xA;&lt;R>E-RR-UI-NAME: 고객검색팝업(A01-1)&#xD;&#xA;&lt;R>E-CALL-SRV-NAME: onCustValueChange()&#xD;&#xA;&lt;R>E-REP: CUSR_NO:고객번호, KOR_NM:한글 고객명, ENG_NM:영문 고객명,JUMIN:주민등록번호, JOB:직업, AGE:나이, NATION:국적, BIRTH:생년월일, DRV_YN:운전여부 &#xD;&#xA;&lt;R>E-REMARK: 컨트롤 ID : udcCustNo" std:sid="ud-control-e408a59c" id="udcCustNo" type="udc.cmn.udcCmnCustNoSearch">
              <cl:datamapbind property="custNo" datacontrolid="dmCustInfo" columnname="custNo"/>
              <cl:datamapbind property="korNm" datacontrolid="dmCustInfo" columnname="korNm"/>
              <cl:datamapbind property="jumin" datacontrolid="dmCustInfo" columnname="jumin"/>
              <cl:datamapbind property="job" datacontrolid="dmCustInfo" columnname="job"/>
              <cl:datamapbind property="age" datacontrolid="dmCustInfo" columnname="age"/>
              <cl:datamapbind property="drvYn" datacontrolid="dmCustInfo" columnname="drvYn"/>
              <cl:datamapbind property="birth" datacontrolid="dmCustInfo" columnname="birth"/>
              <cl:datamapbind property="nation" datacontrolid="dmCustInfo" columnname="nation"/>
              <cl:datamapbind property="engNm" datacontrolid="dmCustInfo" columnname="engNm"/>
              <cl:formdata std:sid="f-data-7c06a3f4" row="0" col="1"/>
            </cl:udc>
            <cl:output std:sid="output-76b3f686" id="optNm">
