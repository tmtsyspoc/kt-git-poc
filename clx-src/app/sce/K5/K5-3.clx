              <cl:verticaldata std:sid="v-data-f9deabd4" width="100px" height="28px" autosize="height"/>
            </cl:output>
            <cl:output std:sid="output-af8e16ae" id="opt3" class="txt" value="`" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;WYSIWYG 기반의 디자인 편집기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해, 스튜디오에서 위지윅하게 구성된 &quot; + sstr(&quot;UI&quot;, [&quot;fw-bold&quot;]) + &quot;를 즉시 &quot; + sstr(&quot;소스코드로 생성&quot;, [&quot;fw-bold&quot;]) + &quot;하여 제공합니다.&quot; + &quot;\n\r&quot; + &quot;또한 스튜디오 내 &quot;+ sstr(&quot;컴파일된 결과보기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해 변환된 소스를 확인 할 수 있으며, 이를 통해 쉽게 동적 컴포넌트 개발을 할 수 있는 환경을 제공합니다.&quot;&#xD;&#xA;">
              <cl:verticaldata std:sid="v-data-dccaa3db" width="1218px" height="61px" autosize="height"/>
            </cl:output>
            <cl:group std:sid="group-8e640236" id="grp2_2">
