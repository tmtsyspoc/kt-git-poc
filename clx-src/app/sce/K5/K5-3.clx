      <cl:tabitem std:sid="t-item-db306129" text="템플릿·UDC 활용 화면">
        <std:metadata>
          <std:property key="is-active-item" value="true"/>
        </std:metadata>
        <cl:group std:sid="group-f065cd04" id="grpTab4" class="conts-area">
          <cl:group std:sid="group-dc2cd14e" id="grpTpGov" class="governing">
            <cl:verticaldata std:sid="v-data-47a58e54" width="976px" height="110px" autosize="height"/>
            <cl:output std:sid="output-5a25a47b" id="optTpTit" class="tit" value="조회·등록·변경 대표화면 - 템플릿과 UDC로 조립">
              <cl:verticaldata std:sid="v-data-81aaa6df" width="100px" height="28px" autosize="height"/>
            </cl:output>
            <cl:output std:sid="output-ba6f50bd" id="optTpTxt" class="txt" value="① 화면 템플릿(그리드+폼)을 복사해 골격 구성 → ② UI 템플릿(조회영역·그리드 타이틀·폼 타이틀) 적용 → ③ UDC(기간·전화번호·이메일·주소·CUD 버튼)를 배치하고 데이터맵에 바인딩합니다. 직접 만들 부분은 업무 로직(조회·저장)뿐이라 구현 시간이 단축됩니다.">
              <cl:verticaldata std:sid="v-data-065e9e0e" width="1218px" height="54px" autosize="height"/>
            </cl:output>
            <cl:verticallayout std:sid="v-layout-9592bafd" scrollable="false" spacing="8"/>
          </cl:group>
          <cl:group std:sid="group-a015375f" id="grpTpSearch" class="sch-filter-box">
            <cl:verticaldata std:sid="v-data-dd88605c" width="976px" height="62px" autosize="height"/>
            <cl:output std:sid="output-23694678" id="optTpS1" class="label" value="고객명">
              <cl:formdata std:sid="f-data-f8f5b75c" row="0" col="0"/>
            </cl:output>
            <cl:inputbox std:sid="i-box-11444099" id="ipbTpSchNm">
              <cl:datamapbind property="value" datacontrolid="dmTpSearch" columnname="NAME"/>
              <cl:formdata std:sid="f-data-f7e1f319" row="0" col="1"/>
            </cl:inputbox>
            <cl:output std:sid="output-89b36e7e" id="optTpS2" class="label" value="가입기간">
              <cl:formdata std:sid="f-data-589602de" row="0" col="2"/>
            </cl:output>
            <cl:udc std:sid="ud-control-38382cf5" id="udcTpFromTo" type="udc.cmn.udcCmnFromTo">
              <cl:datamapbind property="fromDate" datacontrolid="dmTpSearch" columnname="FROM_DT"/>
              <cl:datamapbind property="toDate" datacontrolid="dmTpSearch" columnname="TO_DT"/>
              <cl:formdata std:sid="f-data-19f472d4" row="0" col="3"/>
            </cl:udc>
