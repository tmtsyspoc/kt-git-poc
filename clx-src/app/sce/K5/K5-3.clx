    <cl:tabfolder std:sid="t-folder-7cce2a84" id="tabMain" class="conts-area" headerarrowposition="both">
      <cl:verticaldata std:sid="v-data-7f6b5303" width="100px" height="100%" autosize="none" grow="1"/>
      <cl:tabitem std:sid="t-item-7e649318" selected="true" text="템플릿 제공">
        <cl:group std:sid="group-02736af9" id="grpTab1">
          <cl:group std:sid="group-77420924" id="grp2" class="governing">
            <cl:formdata std:sid="f-data-3c2b5e2d" width="100" height="54" row="0" col="0"/>
            <cl:udc std:sid="ud-control-68223ab3" id="udcComFormTitle2" type="udc.com.udcComFormTitle">
              <cl:verticaldata std:sid="v-data-0c095220" width="800px" height="28px" autosize="height"/>
              <cl:property name="title" value="개발 템플릿 제공" type="string"/>
            </cl:udc>
            <cl:output std:sid="output-c9431d90" id="opt2" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;재사용이 가능한 UI 템플릿 기능&quot;, [&quot;fw-bold&quot;]) + &quot;을 제공합니다.&quot;+ &quot;\n\r&quot; + &quot;이를 통해, 개발 템플릿을 제작하여 쉽고 빠르게 화면을 작성할 수 있습니다. &quot; + sstr(&quot;유형별 개발 템플릿&quot;, [&quot;fw-bold&quot;]) + &quot;과 &quot; + sstr(&quot;다양한 샘플 소스를 제공&quot;, [&quot;fw-bold&quot;]) + &quot;하여 개발 생산성을 향상시킬 수 있습니다.&quot; ">
              <cl:verticaldata std:sid="v-data-5cd92b23" width="1218px" height="48px" autosize="height"/>
            </cl:output>
            <cl:verticallayout std:sid="v-layout-f66b299d" scrollable="false" spacing="8" leftmargin="5" rightmargin="5" topmargin="5" bottommargin="5"/>
          </cl:group>
          <cl:group std:sid="group-362b9075" class="conts-wrap">
