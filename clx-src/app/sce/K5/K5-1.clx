        <cl:group id="grpMprd" class="form">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata width="992px" height="136px" autosize="height"/>
          <cl:output id="optPrdSecd" class="label required" value="상품구분">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:combobox id="cmbMprdInf" fieldLabel="상품구분" preventinput="true">
            <cl:listener name="selection-change" handler="onCmbMprdInfSelectionChange"/>
            <cl:attribute name="required" value="Y"/>
            <cl:datamapbind property="value" datacontrolid="DM_MPRD_PARAM" columnname="PRD_SECD"/>
            <cl:formdata row="0" col="1"/>
            <cl:itemset datasetid="DS_MPRD_INF" label="PRD_SECD" value="PRD_SECD"/>
          </cl:combobox>
          <cl:output id="optPrdcd" class="label required" value="상품">
