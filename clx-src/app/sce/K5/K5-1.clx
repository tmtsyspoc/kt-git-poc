                  <cl:gridcell rowindex="0" colindex="4" targetcolumnname="PRCMPAG" sortable="false" text="나이"/>
                  <cl:gridcell rowindex="0" colindex="5" targetcolumnname="RGDT" sortable="false" text="상령일"/>
                  <cl:gridcell rowindex="0" colindex="6" targetcolumnname="JUPI_RELA" sortable="false" text="주피와의 관계"/>
                  <cl:gridcell rowindex="0" colindex="7" targetcolumnname="CPNM" sortable="false" text="직업"/>
                  <cl:gridcell rowindex="0" colindex="8" targetcolumnname="DRVG_SENM" sortable="false" text="운전"/>
