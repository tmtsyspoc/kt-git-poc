        <cl:verticaldata width="100px" height="36px" autosize="height"/>
      </cl:output>
      <cl:output id="opt9" class="txt" displayexp="&quot;eXBuilder6의 &quot; + sstr(&quot;로봇 테스트 자동화 기능&quot;, [&quot;fw-bold&quot;]) + &quot;은 개발된 화면에 대해 사전에 &quot; + sstr(&quot;정의된 시나리오대로 테스트를 자동으로&quot;, [&quot;fw-bold&quot;]) + &quot; 수행합니다.&quot; + &quot;\n\r&quot; + sstr(&quot;테스트 로그뷰어&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해 실시간으로 결과를 확인하여 &quot; + sstr(&quot;화면 테스트 시간&quot;, [&quot;fw-bold&quot;]) + &quot;을 절감합니다.&quot; ">
