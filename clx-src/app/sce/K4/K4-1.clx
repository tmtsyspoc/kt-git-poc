        <cl:tabitem std:sid="t-item-df41de8e" text="화면디자인 편집기">
          <cl:group std:sid="group-ea448525" id="grpTab3" class="conts-area">
            <cl:group std:sid="group-586883b0" class="governing">
              <cl:verticaldata std:sid="v-data-0e7a7199" width="400px" height="200px" autosize="height"/>
              <cl:output std:sid="output-1b6f9699" class="tit" value="화면디자인 편집기">
                <cl:verticaldata std:sid="v-data-4a671598" width="100px" height="36px" autosize="height"/>
              </cl:output>
              <cl:output std:sid="output-ff847c8a" class="txt" value="" displayexp="&quot;eXBuilder6는 직관적인 화면 디자인 편집기를 통해 UI 컴포넌트를 쉽고 빠르게 배치하고, 트리 구조로 구성 요소를 한눈에 확인할 수 있습니다. 페이지별 템플릿과 팝업·모달·모달리스 기능을 지원하여 &quot; + sstr(&quot;다양한 화면을 효율적으로 제작할 수 있습니다.&quot;, [&quot;fw-bold&quot;])">
                <cl:verticaldata std:sid="v-data-0bc1efa4" width="100px" height="114px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-d4d0b42f" scrollable="false" spacing="16"/>
            </cl:group>
            <cl:group std:sid="group-4e6cc33b">
              <cl:verticaldata std:sid="v-data-c15fd88c" width="976px" height="1810px" autosize="height"/>
              <cl:embeddedapp std:sid="e-app-93c0bc26" src="../A5/A5-9-1.clx">
                <cl:verticaldata std:sid="v-data-39902722" width="320px" height="1810px" autosize="height"/>
              </cl:embeddedapp>
              <cl:verticallayout std:sid="v-layout-f4df73b9" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-d3d2bf21" spacing="16"/>
          </cl:group>
        </cl:tabitem>
        <cl:tabitem std:sid="t-item-5449fc24" text="양방향 편집 충돌 방지">
          <std:metadata>
            <std:property key="is-active-item" value="true"/>
          </std:metadata>
          <cl:group std:sid="group-559f082b" id="grpTab4" class="conts-area">
            <cl:group std:sid="group-7b24b9f2" id="grpRtGov" class="governing">
              <cl:verticaldata std:sid="v-data-69e9f4ea" width="976px" height="110px" autosize="height"/>
              <cl:output std:sid="output-ce6a7f57" id="optRtTit" class="tit" value="디자이너 편집 ↔ 직접 코드 수정 반복 가능">
                <cl:verticaldata std:sid="v-data-77e49730" width="100px" height="28px" autosize="height"/>
              </cl:output>
              <cl:output std:sid="output-c551e599" id="optRtTxt" class="txt" value="화면은 레이아웃·컨트롤·데이터를 담는 .clx(디자이너 관리)와 이벤트 로직을 담는 짝 .js(직접 코드)로 분리됩니다. 둘은 '컨트롤 id'와 '핸들러 이름(on컨트롤ID이벤트)'으로만 연결되므로, 한쪽을 수정해도 다른 쪽이 덮어써지지 않고 반복 편집이 가능합니다.">
                <cl:verticaldata std:sid="v-data-e482310d" width="1218px" height="54px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-f8c0bb01" scrollable="false" spacing="8"/>
            </cl:group>
            <cl:group std:sid="group-9085f470" id="grpRtRule" class="conts-wrap">
              <cl:verticaldata std:sid="v-data-f21f26fe" width="976px" height="250px" autosize="height"/>
              <cl:udc std:sid="ud-control-4328a803" id="udcComGridTitleRt" type="udc.com.udcComGridTitle">
                <cl:verticaldata std:sid="v-data-1646c6f4" width="800px" height="28px" autosize="height"/>
