    <cl:group std:sid="group-c36a587b" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-427952bb" width="976px" height="903px" autosize="none" grow="1"/>
      <cl:tabfolder std:sid="t-folder-39692a08" id="tabMain" class="conts-area" headerarrowposition="both">
        <cl:verticaldata std:sid="v-data-1b220b51" width="100px" height="100%" autosize="none" grow="1"/>
        <cl:tabitem std:sid="t-item-769291ed" selected="true" text="WYSIWYG">
          <cl:group std:sid="group-074ea5b9" id="grpTab1" class="conts-area">
            <cl:group std:sid="group-4205df9e" id="grp1" class="governing">
              <cl:formdata std:sid="f-data-d64f0a40" width="100" height="56" row="0" col="0"/>
              <cl:udc std:sid="ud-control-8ee29e09" id="udcComFormTitle1" type="udc.com.udcComFormTitle">
                <cl:verticaldata std:sid="v-data-d44d887d" width="800px" height="28px" autosize="height"/>
                <cl:property name="title" value="WYSIWYG 기능" type="string"/>
              </cl:udc>
              <cl:group std:sid="group-afb80687" id="grp2">
                <cl:verticaldata std:sid="v-data-8ba3dc5e" width="400px" height="80px" autosize="height"/>
                <cl:output std:sid="output-185d82ae" id="opt18" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;Full WYSIWYG 기반의 강력한 디자인 편집기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해, &quot; + sstr(&quot;쉽고 직관적인 화면 구성방식을 제공&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot; + &quot;\n\r&quot; +&quot;전문 퍼블리셔가 필요 없을 정도로 쉽고 간편한 화면 구성방식은 &quot; + sstr(&quot;퍼블리싱 공수를 획기적으로 절감&quot;, [&quot;fw-bold&quot;]) + &quot;시켜주며, &quot; + sstr(&quot;개발 생산성&quot;, [&quot;fw-bold&quot;]) + &quot; 뿐 아니라, &quot; + sstr(&quot;유지보수의 용이성&quot;, [&quot;fw-bold&quot;]) + &quot; 또한 향상됩니다.&quot;&#xD;&#xA;">
                  <cl:verticaldata std:sid="v-data-26861703" width="1218px" height="77px" autosize="height"/>
                </cl:output>
                <cl:verticallayout std:sid="v-layout-d0ae3060" scrollable="false"/>
              </cl:group>
              <cl:verticallayout std:sid="v-layout-8fe0afdf" scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
            </cl:group>
            <cl:group std:sid="group-3bd68934" class="conts-wrap">
              <cl:formdata std:sid="f-data-9da4cc23" row="1" col="0" rowspan="1" colspan="1"/>
              <cl:udc std:sid="ud-control-bd5456b2" id="udcPocDocViewer1" type="udc.poc.udcPocDocViewer">
                <cl:formdata std:sid="f-data-e847cdc2" row="0" col="0"/>
                <cl:property name="fileUrl" value="../A5/data/docs/A5-5.png" type="resource"/>
              </cl:udc>
              <cl:formlayout std:sid="f-layout-6277fefa" scrollable="false" hspace="0px" vspace="8px" top-margin="16px" right-margin="16px" bottom-margin="16px" left-margin="16px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
              </cl:formlayout>
            </cl:group>
            <cl:formlayout std:sid="f-layout-48f71090" scrollable="false" hspace="16px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="156" unit="PIXEL" autoSizing="true" hidden="true" syncminlength="false"/>
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION"/>
            </cl:formlayout>
          </cl:group>
        </cl:tabitem>
        <cl:tabitem std:sid="t-item-10c781bf" text="코드 생성">
          <cl:group std:sid="group-705fb346" id="grpTab2" class="conts-area">
            <cl:group std:sid="group-bb3643d1" id="grpGoverning" class="governing">
              <cl:formdata std:sid="f-data-d4863371" width="100" height="67" row="0" col="0"/>
              <cl:output std:sid="output-d916977f" id="opt2" class="tit" value="코드 생성 기능">
                <cl:verticaldata std:sid="v-data-af38ce9c" width="100px" height="28px" autosize="height"/>
              </cl:output>
              <cl:output std:sid="output-befada9a" id="opt3" class="txt" value="`" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;WYSIWYG 기반의 디자인 편집기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해, 스튜디오에서 위지윅하게 구성된 &quot; + sstr(&quot;UI&quot;, [&quot;fw-bold&quot;]) + &quot;를 즉시 &quot; + sstr(&quot;소스코드로 생성&quot;, [&quot;fw-bold&quot;]) + &quot;하여 제공합니다.&quot; + &quot;\n\r&quot; + &quot;또한 스튜디오 내 &quot;+ sstr(&quot;컴파일된 결과보기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해 변환된 소스를 확인 할 수 있으며, 이를 통해 쉽게 동적 컴포넌트 개발을 할 수 있는 환경을 제공합니다.&quot;&#xD;&#xA;">
                <cl:verticaldata std:sid="v-data-0f90d830" width="1218px" height="61px" autosize="height"/>
              </cl:output>
              <cl:group std:sid="group-091296e5" id="grp2_2">
                <cl:verticaldata std:sid="v-data-fd05d2dd" width="1208px" height="28px" autosize="none"/>
                <cl:button std:sid="button-0add602d" id="btnCreateCode" value="코드 생성">
                  <cl:listener std:sid="listener-56cced90" name="click" handler="onBtnCreateCodeClick"/>
