      <cl:dataset comment="양방향 편집 책임 영역" std:sid="d-set-7b69e700" id="dsRtRule">
        <cl:datacolumnlist>
          <cl:datacolumn std:sid="d-column-b789486e" name="WORK" datatype="string"/>
          <cl:datacolumn std:sid="d-column-3bfb53ab" name="FILE" datatype="string"/>
