          <cl:datacolumn std:sid="d-column-a040684d" name="REASON" datatype="string"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="WORK"><![CDATA[디자이너 편집]]></cl:datavalue>
            <cl:datavalue columnname="FILE"><![CDATA[화면.clx]]></cl:datavalue>
            <cl:datavalue columnname="CONTENT"><![CDATA[컨트롤 추가·이동·삭제, 레이아웃, 데이터셋, 이벤트 리스너 연결]]></cl:datavalue>
            <cl:datavalue columnname="REASON"><![CDATA[JS 함수 본문은 건드리지 않고 핸들러 이름(참조)만 기록한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="WORK"><![CDATA[직접 코드 수정]]></cl:datavalue>
            <cl:datavalue columnname="FILE"><![CDATA[화면.js]]></cl:datavalue>
            <cl:datavalue columnname="CONTENT"><![CDATA[이벤트 핸들러·공통 호출·업무 로직 작성]]></cl:datavalue>
            <cl:datavalue columnname="REASON"><![CDATA[컨트롤은 app.lookup("id")로만 참조하여 레이아웃 변경에 영향받지 않는다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="WORK"><![CDATA[컨트롤 id 변경]]></cl:datavalue>
            <cl:datavalue columnname="FILE"><![CDATA[clx + js]]></cl:datavalue>
            <cl:datavalue columnname="CONTENT"><![CDATA[디자이너 또는 개명 도구로 id 변경]]></cl:datavalue>
            <cl:datavalue columnname="REASON"><![CDATA[참조까지 일괄 갱신하는 도구를 사용하고, 검증(clx/js validate)으로 불일치를 확인한다.]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec dev-comment="5.5 WYSIWYG&#x9;app/sce/A5/A5-5.clx&#xD;&#xA;5.6 코드 생성&#x9;app/sce/A5/A5-6.clx&#xD;&#xA;5.9 화면디자인 편집기&#x9;app/sce/A5/A5-9.clx&#xD;&#xA;" title="[DEV-03]시각개발·소스편집"/>
