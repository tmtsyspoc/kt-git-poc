              </cl:output>
              <cl:output std:sid="output-8f917873" id="optUdcGovTxt" class="txt" displayexp="&quot;주소·전화번호·기간 같은 입력과 그리드 타이틀·CUD 버튼은 &quot; + sstr(&quot;UDC&quot;, [&quot;fw-bold&quot;]) + &quot;로, 화면 골격은 &quot; + sstr(&quot;화면 템플릿&quot;, [&quot;fw-bold&quot;]) + &quot;으로 제공합니다.&quot; + &quot;\r\n&quot; + &quot;화면마다 새로 만들지 않고 &quot; + sstr(&quot;가져다 속성만 지정&quot;, [&quot;fw-bold&quot;]) + &quot;하면 되므로 개발 시간과 화면 편차가 줄어듭니다.&quot;">
                <cl:verticaldata std:sid="v-data-04b19f31" width="1218px" height="69px" autosize="height"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-df49f8b2" scrollable="false" spacing="8"/>
            </cl:group>
