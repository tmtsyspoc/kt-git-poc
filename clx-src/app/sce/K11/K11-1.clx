</cl:group>
</cl:tabitem>
<cl:tabitem text="소스코드 난독화">
<cl:group id="grpTab2" class="conts-area">
      
      <cl:group id="grp1" class="governing">
        <cl:formdata row="0" col="0"/>
        <cl:output id="opt1_2" class="tit" value="소스코드 난독화 지원">
          <cl:verticaldata width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output id="opt2_2" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;스튜디오 내 간단한 옵션 설정&quot;, [&quot;fw-bold&quot;]) + &quot;을 통해 개발된 &quot; + sstr(&quot;화면 소스의 압축 및 난독화 기능을 사용&quot;, [&quot;fw-bold&quot;]) + &quot;할 수 있습니다.&quot; + &quot;\n\r&quot;+ &quot;이를 통해, &quot; + sstr(&quot;보안성 및 성능&quot;, [&quot;fw-bold&quot;]) + &quot;향상을 지원합니다.&quot;">
          <cl:verticaldata width="1218px" height="74px" autosize="height"/>
        </cl:output>
        <cl:verticallayout scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:group class="conts-wrap">
        <cl:formdata row="1" col="0" rowspan="1" colspan="1"/>
        <cl:udc id="udcPocDocViewer1" type="udc.poc.udcPocDocViewer">
          <cl:formdata row="0" col="0"/>
          <cl:property name="fileUrl" value="../A10/data/docs/A10-5.png" type="resource"/>
        </cl:udc>
        <cl:formlayout scrollable="false" hspace="0px" vspace="8px" top-margin="16px" right-margin="16px" bottom-margin="16px" left-margin="16px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:formlayout scrollable="false" hspace="16px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="120" unit="PIXEL" autoSizing="true" hidden="true" syncminlength="false"/>
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
</cl:tabitem>
<cl:tabitem text="우클릭 방지">
<cl:group id="grpTab3" class="conts-area">
      
      <cl:group class="conts-wrap">
