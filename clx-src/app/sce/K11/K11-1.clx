  <body std:sid="body-c1599b91" class="wrap">
<cl:listener name="before-unload" handler="onBodyBeforeUnload"/>
<cl:listener name="load" handler="onBodyLoad_6"/>
    <cl:udc std:sid="ud-control-ebd56a84" type="udc.com.udcComAppHeader">
      <cl:verticaldata std:sid="v-data-291fd7ba" width="900px" height="28px"/>
    </cl:udc>
    <cl:tabfolder id="tabMain" class="conts-area" headerarrowposition="both">
<cl:verticaldata width="100px" height="100%" autosize="none" grow="1"/>
<cl:tabitem selected="true" text="보안 지원">
<std:metadata><std:property key="is-active-item" value="true"/></std:metadata>
<cl:group id="grpTab1" class="conts-area">
<cl:group id="grpGoverning" class="governing">
      <cl:verticaldata width="992px" height="188px" autosize="height"/>
      <cl:output id="opt7" class="tit" value="보안 지원, XSS, CSRF 방어 등 보안 기능 내장">
        <cl:verticaldata width="100px" height="28px" autosize="height"/>
      </cl:output>
      <cl:output id="opt8" class="txt" displayexp="&quot;eXBuilder6는 데이터 통신시 &quot; + sstr(&quot;제품 자체 스펙으로 입력값 필터, 이스케이프 처리를 지원하여&quot;, [&quot;fw-bold&quot;]) +&quot;, 서버로 전송되는 데이터를 정제할 수 있으며,\n&quot;&#xD;&#xA;+&quot;응답값을 받을 때엔 &quot; + sstr(&quot;html의 innerHTML에 직접 삽입하지 않고 html 요소의 textContent로 값을 소비&quot;, [&quot;fw-bold&quot;]) +&quot;하기 때문에 서버에서 XSS 공격을 가정한 값이 넘어와도 안전한 통신을 지원합니다.\n\n&quot;&#xD;&#xA;+&quot;클라이언트에서 CSRF 방어를 위해서  &quot; + sstr(&quot;CSRF-TOKEN 정보를 서비스 요청 헤더에 추가&quot;, [&quot;fw-bold&quot;]) +&quot;하여 토큰값이 일치하는 경우에만 서비스를 허용하는 정책을 구현할 수 있습니다.&quot;">
        <cl:verticaldata width="1218px" height="118px" autosize="height"/>
      </cl:output>
      <cl:verticallayout scrollable="false" spacing="8"/>
    </cl:group>
<cl:group id="grpData" class="conts-area">
      <cl:verticaldata width="976px" height="903px" autosize="none" grow="1"/>
      <cl:group id="grp2" class="conts-wrap">
        <std:metadata>
          <std:property key="template-uuid" value="f91b19be-4854-4d7d-b7e1-c43b9a18b816"/>
          <std:property key="template-rev" value="5"/>
        </std:metadata>
        <cl:verticaldata width="992px" height="204px" autosize="height"/>
        <cl:group id="grp3">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata width="1240px" height="28px" autosize="height"/>
          <cl:udc id="udcComFormTitle2" type="udc.com.udcComFormTitle">
            <cl:formdata row="0" col="0"/>
            <cl:property name="title" value="XSS. 입력값 필터링, 이스케이프 처리" type="string"/>
          </cl:udc>
          <cl:group id="grp5">
            <cl:formdata row="0" col="1"/>
            <cl:button id="btn1" value="XSS공격이 삽입된 통신 요청">
              <cl:listener name="click" handler="onBtn1Click"/>
              <cl:flowlayoutdata width="210px" height="28px" autosize="width"/>
            </cl:button>
            <cl:flowlayout hspacing="4" vspacing="4" halign="right"/>
          </cl:group>
          <cl:formlayout scrollable="false" hspace="8px" vspace="8px">
            <cl:rows length="28" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:group id="grp4" class="form">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata width="992px" height="46px" autosize="height"/>
          <cl:output id="opt1" class="label" value="요청 파라미터">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:inputbox id="ipb1">
            <cl:datamapbind property="value" datacontrolid="dmRequest" columnname="column1"/>
            <cl:formdata row="0" col="1"/>
          </cl:inputbox>
          <cl:formlayout scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
            <cl:rows length="28" unit="PIXEL"/>
            <cl:columns length="180" unit="PIXEL" shadetype="BY_CLASS"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:group id="grp6" class="form">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata width="992px" height="46px" autosize="height"/>
          <cl:output id="opt2" class="label" value="응답 파라미터">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:inputbox id="ipb2">
            <cl:datamapbind property="value" datacontrolid="dmResponse" columnname="column1"/>
            <cl:formdata row="0" col="1"/>
          </cl:inputbox>
          <cl:formlayout scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
            <cl:rows length="28" unit="PIXEL"/>
            <cl:columns length="180" unit="PIXEL" shadetype="BY_CLASS"/>
