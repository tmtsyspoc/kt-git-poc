        </std:metadata>
        <cl:verticaldata width="992px" height="165px" autosize="height"/>
        <cl:group id="grp8">
          <cl:verticaldata width="1240px" height="28px" autosize="height"/>
          <cl:udc id="udcComFormTitle4" type="udc.com.udcComFormTitle">
            <cl:formdata row="0" col="0"/>
            <cl:property name="title" value="임베디드 페이지 sandbox 속성" type="string"/>
          </cl:udc>
          <cl:group id="grp9">
            <cl:formdata row="0" col="1"/>
            <cl:flowlayout halign="right"/>
          </cl:group>
          <cl:formlayout scrollable="false" hspace="8px" vspace="8px">
            <cl:rows length="28" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:output id="opt3" value="외부 페이지를 삽입하는 경우 임베디드 페이지 컨트롤을 통해 iframe 태그 기능을 지원하며, 이 컨트롤의 sandbox 속성을 통해 외부 페이지 콘텐츠에 대한 추가적인 제항 사항을 지정할 수 있습니다.">
          <cl:verticaldata width="1228px" height="48px" autosize="height"/>
        </cl:output>
        <cl:embeddedpage id="embpage1" src="/app/sce/A7/react/index.html" sandbox="allow-top-navigation">
          <cl:verticaldata width="320px" height="81px"/>
        </cl:embeddedpage>
        <cl:verticallayout spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
      </cl:group>
      <cl:group id="grp10" class="conts-wrap">
        <std:metadata>
          <std:property key="template-uuid" value="f91b19be-4854-4d7d-b7e1-c43b9a18b816"/>
          <std:property key="template-rev" value="5"/>
        </std:metadata>
        <cl:verticaldata width="992px" height="148px" autosize="height"/>
        <cl:group id="grp11">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata width="1240px" height="28px" autosize="height"/>
          <cl:udc id="udcComFormTitle5" type="udc.com.udcComFormTitle">
            <cl:formdata row="0" col="0"/>
            <cl:property name="title" value="CSRF 방어. CSRF 토큰 사용" type="string"/>
          </cl:udc>
          <cl:group id="grp12">
            <cl:attribute name="hide-on-mobile" value="true"/>
            <cl:formdata row="0" col="1"/>
            <cl:flowlayout hspacing="4" halign="right"/>
          </cl:group>
          <cl:formlayout scrollable="false" hspace="8px" vspace="8px">
            <cl:rows length="28" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:group id="grp13" class="form">
          <cl:attribute name="table-min-height" value=""/>
