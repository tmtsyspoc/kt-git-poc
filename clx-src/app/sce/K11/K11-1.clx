          <cl:verticaldata width="1250px" height="75px" autosize="height"/>
          <cl:output id="opt4" class="label" value="토큰 헤더를 포함한 서비스 요청">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:button id="btn2" value="서비스 요청">
            <cl:listener name="click" handler="onBtn2Click"/>
            <cl:formdata row="0" col="1"/>
          </cl:button>
          <cl:button id="btn3" value="서비스 요청">
            <cl:listener name="click" handler="onBtn3Click"/>
            <cl:formdata row="1" col="1"/>
          </cl:button>
          <cl:output id="opt5" class="label" value="토큰 헤더가 포함되어있지 않거나, 잘못된 값을 포함한 서비스 요청">
            <cl:formdata row="1" col="0"/>
          </cl:output>
          <cl:formlayout scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
            <cl:rows length="28" unit="PIXEL"/>
            <cl:rows length="28" unit="PIXEL"/>
