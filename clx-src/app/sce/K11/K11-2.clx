<cl:group id="grpData" class="conts-area" clipcontent="false">
      <cl:verticaldata width="976px" height="903px" autosize="none" grow="1"/>
      <cl:group id="grpContents" class="conts-wrap" clipcontent="false">
        <cl:verticaldata width="992px" height="586px" autosize="height"/>
        <cl:group id="grpCont">
          <cl:verticaldata width="1260px" height="500px" autosize="none"/>
          <cl:group id="grp2">
            <cl:formdata row="0" col="0"/>
            <cl:udc id="udcComGridTitle1" type="udc.com.udcComGridTitle">
              <cl:formdata row="0" col="0"/>
              <cl:property name="ctrl" value="grdList" type="control"/>
              <cl:property name="title" value="암호화 그리드 목록" type="string"/>
            </cl:udc>
            <cl:formlayout scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="1" unit="FRACTION"/>
              <cl:columns length="1" unit="FRACTION" autoSizing="true" shadetype="NONE" shadecolor="transparent"/>
            </cl:formlayout>
          </cl:group>
          <cl:grid id="grdList" style="text-align:center;" fieldLabel="암호화 그리드 목록" datasetid="dsList" autofit="4, 5, 6, 7, 8, 9" resizablecolumns="1, 2, 3, 4, 5, 6, 7, 8, 9" columnMovable="true">
            <cl:formdata row="1" col="0"/>
            <cl:gridcolumn width="120px"/>
            <cl:gridcolumn width="60px"/>
            <cl:gridcolumn width="100px"/>
            <cl:gridcolumn width="90px"/>
            <cl:gridcolumn width="135px"/>
            <cl:gridcolumn width="135px"/>
            <cl:gridcolumn width="170px"/>
            <cl:gridcolumn width="170px"/>
            <cl:gridcolumn width="210px"/>
            <cl:gridcolumn width="150px"/>
            <cl:gridheader>
              <cl:gridrow height="44px"/>
              <cl:gridcell rowindex="0" colindex="1" targetcolumnname="SQNO" sortable="false" filterable="false" text="번호"/>
              <cl:gridcell rowindex="0" colindex="2" targetcolumnname="SEX_DIS" text="성별"/>
              <cl:gridcell rowindex="0" colindex="3" targetcolumnname="FNM" text="성명"/>
              <cl:gridcell rowindex="0" colindex="4" targetcolumnname="BZNO" sortable="false" filterable="false" text="사업자등록번호"/>
              <cl:gridcell rowindex="0" colindex="5" targetcolumnname="RRNO" sortable="false" filterable="false" text="주민등록번호"/>
              <cl:gridcell rowindex="0" colindex="6" targetcolumnname="ACNO" sortable="false" filterable="false" text="계좌번호"/>
              <cl:gridcell rowindex="0" colindex="7" targetcolumnname="EMAIL" sortable="false" filterable="false" text="이메일"/>
              <cl:gridcell rowindex="0" colindex="8" targetcolumnname="CDNO" sortable="false" filterable="false" text="카드번호"/>
              <cl:gridcell rowindex="0" colindex="9" targetcolumnname="CNAD_NO" sortable="false" filterable="false" text="연락처"/>
              <cl:gridcell rowindex="0" colindex="0" text="암호화 데이터 표시"/>
            </cl:gridheader>
            <cl:griddetail>
              <cl:gridrow height="45px"/>
              <cl:gridcell rowindex="0" colindex="1" columntype="rowindex"/>
              <cl:gridcell rowindex="0" colindex="2" columnname="SEX_DIS">
                <cl:combobox id="cmb1" readonly="true">
                  <cl:celldata/>
                  <cl:item label="남자" value="1"/>
                  <cl:item label="여자" value="2"/>
                </cl:combobox>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="3" columnname="FNM">
                <cl:output id="opt3" style="text-align:center;" visible="true">
                  <cl:celldata/>
                </cl:output>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="4" columnname="BZNO">
                <cl:inputbox id="ipb1">
                  <cl:celldata/>
                </cl:inputbox>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="5" columnname="RRNO">
                <cl:output id="opt2">
                  <cl:expbind property="value" category="PROPERTY" expression="isCheckedRow(rowIndex) ? @setMask(&quot;JUMIN&quot;, RRNO, false) : @setMask(&quot;JUMIN&quot;, RRNO, true)&#xD;&#xA;&#xD;&#xA;"/>
                  <cl:celldata/>
                </cl:output>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="6" columnname="ACNO">
                <cl:maskeditor id="mse1">
                  <cl:expbind property="mask" category="PROPERTY" expression="isCheckedRow(rowIndex) ? &quot;000-00000-0000&quot; : &quot;00*-0000*-000*&quot;"/>
                  <cl:celldata/>
                </cl:maskeditor>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="7" columnname="EMAIL">
                <cl:inputbox id="ipb4">
                  <cl:celldata/>
                </cl:inputbox>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="8" columnname="CDNO">
                <cl:maskeditor id="mse2">
                  <cl:expbind property="mask" category="PROPERTY" expression="isCheckedRow(rowIndex) ? &quot;0000-0000-0000-0000&quot; : &quot;0000-0000-****-0000&quot;"/>
                  <cl:celldata/>
                </cl:maskeditor>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="9" columnname="CNAD_NO">
                <cl:inputbox id="ipb6">
                  <cl:celldata/>
                </cl:inputbox>
              </cl:gridcell>
              <cl:gridcell rowindex="0" colindex="0" columntype="checkbox"/>
            </cl:griddetail>
          </cl:grid>
          <cl:formlayout scrollable="false" hspace="0px" vspace="8px">
            <cl:rows length="28" unit="PIXEL" autoSizing="true"/>
