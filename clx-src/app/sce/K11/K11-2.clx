<cl:group id="grpContents2" class="conts-wrap" clipcontent="false">
      <cl:verticaldata width="976px" height="542px" autosize="height"/>
      <cl:group id="grpCont2">
        <cl:verticaldata width="942px" height="456px" autosize="height"/>
        <cl:udc type="udc.com.udcComFormTitle">
          <cl:formdata row="0" col="0"/>
          <cl:property name="title" value="데이터 마스킹 처리" type="string"/>
          <cl:property name="visiblePopGrp" value="false" type="boolean"/>
        </cl:udc>
        <cl:checkbox value="true" text="마스킹 설정">
          <cl:listener name="value-change" handler="onCheckBoxValueChange"/>
          <cl:formdata row="0" col="1"/>
        </cl:checkbox>
        <cl:group id="grpForm" class="form">
          <cl:formdata width="100" height="-19" row="1" col="0" rowspan="1" colspan="2"/>
          <cl:output class="label" value="주민등록번호(ssn)">
            <cl:formdata row="0" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:maskeditor id="mseSsn" value="1111111111111" mask="000000-0******">
            <cl:formdata row="0" col="1"/>
          </cl:maskeditor>
          <cl:output class="label" value="외국인등록번호(foreign)">
            <cl:formdata row="1" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:maskeditor id="mseSsn2" value="1111111111111" mask="000000-0******">
            <cl:formdata row="1" col="1"/>
          </cl:maskeditor>
          <cl:output class="label" value="주민번호/외국인등록번호(ssnAll)">
            <cl:formdata row="2" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:maskeditor id="mseSsn3" value="1111111111111" mask="000000-0******">
            <cl:formdata row="2" col="1"/>
          </cl:maskeditor>
          <cl:output class="label" value="사업자등록번호(brn)">
            <cl:formdata row="3" col="0" ignore-layout-spacing="true"/>
          </cl:output>
          <cl:maskeditor value="1234567890" mask="000-00-00000">
            <cl:formdata row="3" col="1"/>
