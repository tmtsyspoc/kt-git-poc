        <cl:output class="tit" value="리스소 암호화 검증">
          <cl:verticaldata width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output class="txt" value="devtools-detector.js 라이브러리는 브라우저 개발자 도구(DevTools)의 열림 여부를 감지하는 데 사용됩니다. &#xD;&#xA;이 기능을 통해 웹 리소스(예: JavaScript 코드, 민감한 데이터 등)에 대한 보안 또는 무결성 검사를 강화하거나, 디버깅 시도를 차단하는 방어 로직을 구성할 수 있습니다.">
          <cl:verticaldata width="1218px" height="43px" autosize="height"/>
        </cl:output>
        <cl:verticallayout scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:group class="conts-wrap">
        <cl:formdata width="100" height="4" row="1" col="0"/>
        <cl:group class="form">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata width="992px" height="91px" autosize="height"/>
          <cl:output class="label" value="개발자 도구 탐지">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:group>
            <cl:formdata row="0" col="1" rowspan="1" colspan="1"/>
            <cl:button value="시작">
              <cl:listener name="click" handler="onBtn1Click"/>
              <cl:flowlayoutdata width="70px" height="28px"/>
            </cl:button>
            <cl:button value="종료">
              <cl:listener name="click" handler="onBtnStart2Click"/>
              <cl:flowlayoutdata width="70px" height="28px" autosize="none"/>
            </cl:button>
            <cl:flowlayout/>
          </cl:group>
          <cl:output class="label" value="개발자 도구 탐지 중단">
            <cl:formdata row="1" col="0"/>
          </cl:output>
          <cl:radiobutton id="rdbCrash" enabled="false">
            <cl:listener name="selection-change" handler="onRdbCrashSelectionChange"/>
