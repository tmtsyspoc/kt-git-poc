<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-f17a0101" version="1.0.5186">
  <head std:sid="head-f17a0102">
    <screen std:sid="screen-f17a0103" id="EXB-POP[1024]" name="EXB-POP[1024]" width="1024px" height="576px" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f17a0104" id="EXB-POP[800]" name="EXB-POP[800]" width="800px" height="480px" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f17a0105" id="EXB-POP[480]" name="EXB-POP[480]" width="480px" height="320px" customHeight="600" customWidth="800" active="true"/>
    <cl:model std:sid="model-f17a0106">
      <cl:dataset comment="값 목록 — 대상 열의 서로 다른 값(value)과 화면 글자(label) (AS-IS sc-grid-filter 값 그리드 filterData)" std:sid="d-set-f17a0107" id="dsValues">
        <cl:datacolumnlist>
          <cl:datacolumn std:sid="d-column-f17a0108" name="label"/>
          <cl:datacolumn std:sid="d-column-f17a0109" name="value"/>
          <cl:datacolumn comment="maItems 순번 (검색으로 목록을 다시 만들어도 체크를 되살리는 키)" std:sid="d-column-f17a014c" name="idx" datatype="number"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset comment="조건 종류 11개 (AS-IS filterKindItems)" std:sid="d-set-f17a010a" id="dsKind">
        <cl:datacolumnlist>
          <cl:datacolumn std:sid="d-column-f17a010b" name="label"/>
          <cl:datacolumn std:sid="d-column-f17a010c" name="value"/>
        </cl:datacolumnlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="필터"/>
  </head>
  <body std:sid="body-f17a010d" class="pop-content-wrapper" clipcontent="true" childcombinatorclass="v_base">
    <cl:listener std:sid="listener-f17a010e" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-f17a010f" name="unload" handler="onBodyUnload"/>
    <cl:udc std:sid="ud-control-f17a0110" id="udccomappheader1" visible="false" type="udc.com.udcComAppHeader">
      <cl:verticaldata std:sid="v-data-f17a0111" width="1580px" height="25px" autosize="height"/>
    </cl:udc>
    <cl:group std:sid="group-f17a0112" id="grpData" class="pop-content-body">
      <cl:verticaldata std:sid="v-data-f17a0113" width="480px" height="280px" autosize="height"/>
      <cl:searchinput std:sid="s-input-f17a0114" id="sipSearch" fieldLabel="Search" hideclearbutton="false" placeholder="Search">
        <cl:listener std:sid="listener-f17a0115" name="input" handler="onSipSearchInput"/>
        <cl:listener std:sid="listener-f17a0116" name="clear" handler="onSipSearchInput"/>
        <cl:listener std:sid="listener-f17a0117" name="search" handler="onSipSearchSearch"/>
        <cl:verticaldata std:sid="v-data-f17a0118" width="432px" height="28px"/>
      </cl:searchinput>
      <cl:group std:sid="group-f17a0119" id="grpListHead">
        <cl:verticaldata std:sid="v-data-f17a011a" width="432px" height="26px"/>
        <cl:button std:sid="button-f17a011b" id="btnCheckAll" class="btn-base" tooltip="전체 선택" value="전체 선택">
          <cl:listener std:sid="listener-f17a011c" name="click" handler="onBtnCheckAllClick"/>
          <cl:formdata std:sid="f-data-f17a011d" row="0" col="0"/>
        </cl:button>
        <cl:button std:sid="button-f17a011e" id="btnUncheckAll" class="btn-base" tooltip="전체 해제" value="전체 해제">
          <cl:listener std:sid="listener-f17a011f" name="click" handler="onBtnUncheckAllClick"/>
          <cl:formdata std:sid="f-data-f17a0120" row="0" col="1"/>
        </cl:button>
        <cl:output std:sid="output-f17a0121" id="optResults" style="text-align:right;" value="Results : 0">
          <cl:formdata std:sid="f-data-f17a0122" row="0" col="2"/>
        </cl:output>
        <cl:formlayout std:sid="f-layout-f17a0123" scrollable="false" hspace="4px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="80" unit="PIXEL"/>
          <cl:columns length="80" unit="PIXEL"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:grid std:sid="grid-f17a0124" id="grdValues" fieldLabel="값 목록" tooltip="그리드에 포커스 후 붙여넣기를 하면 붙여넣기 한 데이터가 선택됩니다." readonly="true" datasetid="dsValues" autofit="1">
        <cl:attribute name="__excludeFillHeight__" value="true"/>
        <cl:attribute name="selectAfterLoad" value="N"/>
        <cl:verticaldata std:sid="v-data-f17a0125" width="432px" height="170px"/>
        <cl:gridcolumn std:sid="g-column-f17a0126" width="36px"/>
        <cl:gridcolumn std:sid="g-column-f17a0127" width="200px"/>
        <cl:gridheader std:sid="gh-band-f17a0128">
          <cl:gridrow std:sid="g-row-f17a0129" height="0px"/>
          <cl:gridcell std:sid="gh-cell-f17a012a" rowindex="0" colindex="0" columntype="checkbox"/>
          <cl:gridcell std:sid="gh-cell-f17a012b" rowindex="0" colindex="1" targetcolumnname="label" text="값"/>
        </cl:gridheader>
        <cl:griddetail std:sid="gd-band-f17a012c">
          <cl:gridrow std:sid="g-row-f17a012d" height="28px"/>
          <cl:gridcell std:sid="gd-cell-f17a012e" rowindex="0" colindex="0" columntype="checkbox"/>
          <cl:gridcell std:sid="gd-cell-f17a012f" rowindex="0" colindex="1" class="dqms-cell-left" columnname="label"/>
        </cl:griddetail>
      </cl:grid>
      <cl:group std:sid="group-f17a0130" id="grpCondition">
        <cl:verticaldata std:sid="v-data-f17a0131" width="432px" height="28px"/>
        <cl:combobox std:sid="c-box-f17a0132" id="cmbKind" fieldLabel="조건" value="includePattern">
          <cl:formdata std:sid="f-data-f17a0133" row="0" col="0"/>
          <cl:itemset datasetid="dsKind" label="label" value="value"/>
        </cl:combobox>
        <cl:inputbox std:sid="i-box-f17a0134" id="ipbWord" fieldLabel="조건 값">
          <cl:listener std:sid="listener-f17a0135" name="keydown" handler="onIpbWordKeydown"/>
          <cl:formdata std:sid="f-data-f17a0136" row="0" col="1"/>
        </cl:inputbox>
        <cl:formlayout std:sid="f-layout-f17a0137" scrollable="false" hspace="6px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-f17a0138" scrollable="false" spacing="8"/>
    </cl:group>
    <cl:group std:sid="group-f17a0139" id="grpFooter" class="pop-content-footer">
      <cl:verticaldata std:sid="v-data-f17a013a" width="480px" height="56px" autosize="height"/>
      <cl:group std:sid="group-f17a013b" class="footer-button-group">
        <cl:verticaldata std:sid="v-data-f17a013c" width="432px" height="32px" autosize="height"/>
        <cl:group std:sid="group-f17a013d">
          <cl:formdata std:sid="f-data-f17a013e" row="0" col="0"/>
          <cl:button std:sid="button-f17a013f" id="btnClipboard" class="btn-base" value="클립보드 가져오기">
            <cl:listener std:sid="listener-f17a0140" name="click" handler="onBtnClipboardClick"/>
            <cl:flowlayoutdata std:sid="f-data-f17a0141" width="134px" height="32px" autosize="width"/>
          </cl:button>
          <cl:button std:sid="button-f17a0142" id="btnApply" class="btn-submit" value="적용">
            <cl:listener std:sid="listener-f17a0143" name="click" handler="onBtnApplyClick"/>
            <cl:flowlayoutdata std:sid="f-data-f17a0144" width="58px" height="32px" autosize="width"/>
          </cl:button>
          <cl:button std:sid="button-f17a0145" id="btnClose" class="btn-base" value="닫기">
            <cl:listener std:sid="listener-f17a0146" name="click" handler="onBtnCloseClick"/>
            <cl:flowlayoutdata std:sid="f-data-f17a0147" width="58px" height="32px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-f17a0148" scrollable="false" hspacing="4" halign="center"/>
        </cl:group>
        <cl:formlayout std:sid="f-layout-f17a0149" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-f17a014a" scrollable="false"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-f17a014b" scrollable="false"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>