          <cl:button class="text" value="모두읽기" icon="0">
            <cl:listener name="click" handler="onButtonClick3"/>
            <cl:flowlayoutdata width="100px" height="24px" autosize="both"/>
            <cl:iconstyle class="icon ico-check"/>
          </cl:button>
          <cl:button class="text" value="전체삭제" icon="0">
            <cl:listener name="click" handler="onButtonClick6"/>
            <cl:flowlayoutdata width="100px" height="24px" autosize="both"/>
            <cl:iconstyle class="icon ico-trash"/>
          </cl:button>
          <cl:flowlayout vspacing="0" halign="right"/>
        </cl:group>
        <cl:group id="grpAlarmWrap" class="list" clipcontent="true">
          <cl:formdata row="1" col="0"/>
          <cl:group class="item new" removeOnBuild="true">
            <cl:verticaldata width="400px" height="56px" autosize="height"/>
            <cl:output class="txt" value="새로운 결재 대기 문서가 있습니다.">
              <cl:verticaldata width="100px" height="20px" autosize="height"/>
            </cl:output>
            <cl:output class="date" value="10분 전">
              <cl:verticaldata width="100px" height="20px" autosize="height"/>
            </cl:output>
            <cl:verticallayout/>
          </cl:group>
          <cl:verticallayout scrollable="true" spacing="8"/>
        </cl:group>
        <cl:formlayout scrollable="false" hspace="0px" vspace="8px" top-margin="12px" right-margin="12px" bottom-margin="12px" left-margin="12px">
          <cl:rows length="24" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:formlayout scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px" hseparatorwidth="1" hseparatortype="BY_CLASS">
        <cl:rows length="40" unit="PIXEL" autoSizing="true" syncminlength="false"/>
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
    <cl:group id="grpHelp" class="floating-box kt-help" visible="false">
      <cl:xylayoutdata top="386px" right="-560px" width="260px" height="212px" horizontalAnchor="RIGHT" verticalAnchor="TOP"/>
      <cl:output class="tit" value="지원">
        <cl:verticaldata width="100px" height="20px"/>
      </cl:output>
      <cl:group>
        <cl:verticaldata width="228px" height="28px"/>
        <cl:button id="btnHelpManual" class="secondary" value="매뉴얼">
          <cl:listener name="click" handler="onBtnHelpItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:button id="btnHelpFaq" class="secondary" value="FAQ">
          <cl:listener name="click" handler="onBtnHelpItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:button id="btnHelpKnow" class="secondary" value="지식">
          <cl:listener name="click" handler="onBtnHelpItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:flowlayout hspacing="6" vspacing="0" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:output class="tit sub" value="단축키">
        <cl:verticaldata width="100px" height="20px"/>
      </cl:output>
      <cl:output value="F2  고객 통합검색">
        <cl:verticaldata width="100px" height="18px"/>
      </cl:output>
      <cl:output value="F4  메뉴 검색">
        <cl:verticaldata width="100px" height="18px"/>
      </cl:output>
      <cl:output value="Enter  검색 실행 / To-Do 추가">
        <cl:verticaldata width="100px" height="18px"/>
      </cl:output>
      <cl:output value="탭 우클릭  탭 닫기·새창 메뉴">
        <cl:verticaldata width="100px" height="18px"/>
      </cl:output>
      <cl:verticallayout scrollable="false" spacing="6" leftmargin="16" rightmargin="16" topmargin="14" bottommargin="14"/>
    </cl:group>
    <cl:group id="grpCalc" class="floating-box kt-help" visible="false">
      <cl:xylayoutdata top="610px" right="-560px" width="260px" height="100px" horizontalAnchor="RIGHT" verticalAnchor="TOP"/>
      <cl:output class="tit" value="요금 계산기">
        <cl:verticaldata width="100px" height="20px"/>
      </cl:output>
      <cl:group>
        <cl:verticaldata width="228px" height="28px"/>
        <cl:button id="btnCalcHome" class="secondary" value="홈">
          <cl:listener name="click" handler="onBtnCalcItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:button id="btnCalcWire" class="secondary" value="유선">
          <cl:listener name="click" handler="onBtnCalcItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:button id="btnCalcBundle" class="secondary" value="결합">
          <cl:listener name="click" handler="onBtnCalcItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:button id="btnCalcMobile" class="secondary" value="무선">
          <cl:listener name="click" handler="onBtnCalcItemClick"/>
          <cl:flowlayoutdata width="60px" height="28px" autosize="width"/>
        </cl:button>
        <cl:flowlayout hspacing="6" vspacing="0" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:verticallayout scrollable="false" spacing="10" leftmargin="16" rightmargin="16" topmargin="14" bottommargin="14"/>
    </cl:group>
    <cl:group id="grpCurtain" class="kt-curtain" visible="false">
      <cl:xylayoutdata top="550px" right="-680px" width="360px" height="200px" horizontalAnchor="RIGHT" verticalAnchor="TOP"/>
      <cl:output class="tit" value="화면 가리기 중">
        <cl:formdata row="1" col="0"/>
      </cl:output>
      <cl:output class="sub" value="고객 정보 보호를 위해 화면을 가렸습니다.">
        <cl:formdata row="2" col="0"/>
      </cl:output>
      <cl:button id="btnCurtainOff" class="primary" value="화면 다시 보기">
        <cl:listener name="click" handler="onBtnCurtainOffClick"/>
        <cl:formdata halign="CENTER" width="160" row="3" col="0"/>
      </cl:button>
      <cl:formlayout scrollable="false" hspace="0px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="1" unit="FRACTION"/>
        <cl:rows length="36" unit="PIXEL"/>
        <cl:rows length="24" unit="PIXEL"/>
        <cl:rows length="40" unit="PIXEL"/>
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
    <cl:xylayout scrollable="true"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>