<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" version="1.0.5996">
  <head>
    <screen id="default" name="default" width="1640px" height="984px" useCustomWidth="true" useCustomHeight="true" customHeight="1080" customWidth="1920" active="true"/>
    <screen id="tablet" name="tablet" width="1023px" height="767px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen id="mobile" name="mobile" width="0px" height="767px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <cl:model>
      <cl:dataset id="dsAllMenu" filtercondition="USE_YN != &quot;N&quot;">
        <cl:datacolumnlist>
          <cl:datacolumn comment="메뉴명" name="MENU_NM"/>
          <cl:datacolumn comment="메뉴ID" name="MENU_ID"/>
          <cl:datacolumn comment="상위메뉴ID" name="UP_MENU_ID"/>
          <cl:datacolumn comment="즐겨찾기 여부" name="MENU_FAV"/>
          <cl:datacolumn comment="내업무 여부" name="MENU_WORK" datatype="string" displayonly="false"/>
          <cl:datacolumn comment="호출 화면 경로" name="CALL_PAGE"/>
          <cl:datacolumn comment="사용여부" name="USE_YN"/>
          <cl:datacolumn comment="검증방식" name="MENU_TYPE"/>
        </cl:datacolumnlist>
        <cl:datarowlist/>
      </cl:dataset>
      <cl:dataset comment="알림 메세지" id="dsNotiMsg">
        <cl:datacolumnlist>
          <cl:datacolumn name="KEY" datatype="number"/>
          <cl:datacolumn comment="메세지 유형" name="TYPE"/>
          <cl:datacolumn comment="메세지 내용" name="MSG"/>
          <cl:datacolumn comment="알림방 추가 여부" name="REPLAY"/>
          <cl:datacolumn comment="읽음 여부" name="READ_YN"/>
          <cl:datacolumn comment="발신자명" name="SENDER_NM"/>
          <cl:datacolumn comment="발신자아이디" name="SENDER_ID"/>
          <cl:datacolumn comment="요청상태값" name="APPR_RESULT"/>
          <cl:datacolumn comment="메시지 제목" name="MSG_TITLE"/>
          <cl:datacolumn comment="메시지 상세내용" name="CONTENTS"/>
          <cl:datacolumn comment="[관리자승인] 문서 종류" name="APPR_KIND"/>
          <cl:datacolumn name="ADMIN_MSG"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset id="dsOpenMenus">
        <cl:datacolumnlist>
          <cl:datacolumn name="label"/>
          <cl:datacolumn name="value"/>
          <cl:datacolumn name="menuId"/>
          <cl:datacolumn name="id"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset comment="빠른 업무(대리점 주요 업무 바로가기). CALL_PAGE 에 화면 경로를 넣으면 연결된다." id="dsQuickTask">
        <cl:datacolumnlist>
          <cl:datacolumn comment="업무명" name="LABEL"/>
          <cl:datacolumn comment="아이콘 클래스" name="ICON"/>
          <cl:datacolumn comment="호출 화면 경로" name="CALL_PAGE"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">신규가입</cl:datavalue>
            <cl:datavalue columnname="ICON">t-new</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE">app/kos/KosJoin.clx</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">번호이동</cl:datavalue>
            <cl:datavalue columnname="ICON">t-mnp</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE">app/kos/KosMnp.clx</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">기기변경</cl:datavalue>
            <cl:datavalue columnname="ICON">t-chg</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE">app/kos/KosDevChg.clx</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">요금수납</cl:datavalue>
            <cl:datavalue columnname="ICON">t-pay</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE">app/kos/KosPay.clx</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">요금제변경</cl:datavalue>
            <cl:datavalue columnname="ICON">t-plan</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE"></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">정지/해지</cl:datavalue>
            <cl:datavalue columnname="ICON">t-stop</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE"></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">명의변경</cl:datavalue>
            <cl:datavalue columnname="ICON">t-name</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE"></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="LABEL">단말재고</cl:datavalue>
            <cl:datavalue columnname="ICON">t-stock</cl:datavalue>
            <cl:datavalue columnname="CALL_PAGE"></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:dataset comment="최근 조회 고객(화면 메모리에만 보관)" id="dsRecentCust">
        <cl:datacolumnlist>
          <cl:datacolumn comment="표시(마스킹)" name="LABEL"/>
          <cl:datacolumn comment="검색조건(JSON)" name="VAL"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset comment="To-Do 목록" id="dsTodo">
        <cl:datacolumnlist>
          <cl:datacolumn comment="To-Do ID" name="TODO_ID"/>
          <cl:datacolumn comment="할 일" name="TITLE"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:datamap comment="오늘의 처리 현황" id="dmTodayStat">
        <cl:datacolumnlist>
          <cl:datacolumn comment="신규가입" name="NEW_CNT" datatype="number" defaultvalue="0"/>
          <cl:datacolumn comment="번호이동" name="MNP_CNT" datatype="number" defaultvalue="0"/>
          <cl:datacolumn comment="기기변경" name="CHG_CNT" datatype="number" defaultvalue="0"/>
          <cl:datacolumn comment="요금수납" name="PAY_CNT" datatype="number" defaultvalue="0"/>
          <cl:datacolumn comment="해지" name="TERM_CNT" datatype="number" defaultvalue="0"/>
          <cl:datacolumn comment="미처리" name="PEND_CNT" datatype="number" defaultvalue="0"/>
        </cl:datacolumnlist>
      </cl:datamap>
      <cl:datamap comment="사용자 정보" id="dmUserInfo">
        <cl:datacolumnlist>
          <cl:datacolumn info="사용자ID" name="USER_ID" defaultvalue="admin"/>
          <cl:datacolumn info="사용자명" name="USER_NM" defaultvalue="김케이"/>
          <cl:datacolumn info="부서명" name="DEPT_NM" defaultvalue=""/>
          <cl:datacolumn info="부서코드" name="DEPT_CD" defaultvalue=""/>
          <cl:datacolumn name="USER_TYPE" defaultvalue="admin"/>
        </cl:datacolumnlist>
      </cl:datamap>
      <cl:datamap comment="프로젝트 설정 컨피그" id="dmGlobalConfig">
        <cl:datacolumnlist>
          <cl:datacolumn comment="mdi 최대 오픈 갯수" name="mdiWindowMaxCount" defaultvalue="-1"/>
          <cl:datacolumn comment="디폴트 언어키" name="defaultLocale"/>
          <cl:datacolumn comment="디비전 사용 여부" name="divideMdiUseYn"/>
          <cl:datacolumn comment="알림(alert, confirm)시 레이어드팝업 사용 여부" name="useLayerdPop" defaultvalue="N"/>
          <cl:datacolumn comment="mdi 탭 개수 초과시 옵션" name="mdiFirstClose"/>
        </cl:datacolumnlist>
      </cl:datamap>
      <cl:submission id="subLogOut" action="/Login/logout.do"/>
      <cl:submission id="subOnLoad" action="app/exam/data/main.json">
        <cl:responsedata dataid="dsAllMenu" isadd="false"/>
        <cl:responsedata dataid="dmGlobalConfig"/>
        <cl:responsedata dataid="dmUserInfo"/>
      </cl:submission>
      <cl:submission comment="대리점 현황·대리점 업무 메뉴(목업 데이터)" id="subDealer" action="app/exam/data/mainKt.json">
        <cl:responsedata dataid="dmTodayStat"/>
        <cl:responsedata dataid="dsAllMenu" isadd="true"/>
      </cl:submission>
    </cl:model>
    <cl:appspec title="KT 메인"/>
  </head>
  <body class="main main-kt" clipcontent="false">
    <cl:listener name="screen-change" handler="onBodyScreenChange"/>
    <cl:listener name="init" handler="onBodyInit"/>
    <cl:group id="grpHeader" class="kt-top" clipcontent="false">
      <cl:xylayoutdata top="0px" right="0px" left="0px" height="52px" horizontalAnchor="BOTH" verticalAnchor="TOP"/>
      <cl:group>
        <cl:formdata row="0" col="0"/>
        <cl:button id="btnLogo" class="logo" fieldLabel="KT 로고(새로고침)" tooltip="새로고침" value="">
          <cl:listener name="click" handler="onBtnLogoClick"/>
          <cl:formdata row="0" col="0"/>
        </cl:button>
        <cl:output class="sys-name" value="KOS">
          <cl:formdata row="0" col="1"/>
        </cl:output>
        <cl:output class="sys-sub" value="대리점 영업지원">
          <cl:formdata row="0" col="2"/>
        </cl:output>
        <cl:button id="btnSitemap" class="sitemap" tooltip="전체메뉴(사이트맵)" value="전체메뉴">
          <cl:listener name="click" handler="onBtnSitemapClick"/>
          <cl:formdata valign="CENTER" height="28" row="0" col="3"/>
        </cl:button>
        <cl:button id="btnHeaderMenu" class="btn-nav" visible="false" fieldLabel="메뉴 열기" value="" icon="0">
          <cl:listener name="click" handler="onBtnHeaderMenuClick"/>
          <cl:formdata halign="CENTER" valign="CENTER" width="24" height="24" row="0" col="5"/>
        </cl:button>
        <cl:formlayout scrollable="false" hspace="8px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="40" unit="PIXEL"/>
          <cl:columns length="48" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          <cl:columns length="90" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          <cl:columns length="84" unit="PIXEL"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="24" unit="PIXEL"/>
        </cl:formlayout>
      </cl:group>
      <cl:group id="grpCustSch" class="kt-cust" clipcontent="false">
        <cl:formdata valign="CENTER" height="36" row="0" col="1"/>
        <cl:group class="pill">
          <cl:flowlayoutdata width="540px" height="36px" autosize="none"/>
          <cl:combobox id="cmbCustSchType" fieldLabel="고객 검색구분" value="TEL">
            <cl:formdata row="0" col="0"/>
            <cl:item label="전화번호" value="TEL"/>
            <cl:item label="서비스번호" value="SVC"/>
            <cl:item label="고객명" value="NM"/>
            <cl:item label="청구번호" value="BILL"/>
          </cl:combobox>
          <cl:inputbox id="ipbCustSchVal" fieldLabel="고객 검색어" placeholder="고객 검색 (F2) · 입력 후 Enter" maxlength="30">
            <cl:listener name="keydown" handler="onIpbCustSchValKeydown"/>
            <cl:formdata row="0" col="1"/>
          </cl:inputbox>
          <cl:inputbox id="ipbCustBirth" fieldLabel="생년월일" placeholder="생년월일(YYMMDD)" maxlength="6" inputfilter="[0-9]">
            <cl:listener name="keydown" handler="onIpbCustBirthKeydown"/>
            <cl:formdata row="0" col="2"/>
          </cl:inputbox>
          <cl:button id="btnCustSch" class="sch" fieldLabel="고객조회" tooltip="고객조회" value="" icon="0">
            <cl:listener name="click" handler="onBtnCustSchClick"/>
            <cl:formdata halign="CENTER" valign="CENTER" width="28" height="28" row="0" col="3"/>
          </cl:button>
          <cl:formlayout scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="4px" bottom-margin="0px" left-margin="8px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="112" unit="PIXEL"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="140" unit="PIXEL"/>
            <cl:columns length="32" unit="PIXEL"/>
          </cl:formlayout>
        </cl:group>
        <cl:checkbox id="cbxCustTerm" text="해지포함" truevalue="Y" falsevalue="N" value="N">
          <cl:flowlayoutdata width="80px" height="36px" autosize="width"/>
        </cl:checkbox>
        <cl:flowlayout hspacing="12" vspacing="0" halign="left"/>
      </cl:group>
      <cl:group class="kt-utils" clipcontent="false">
        <cl:formdata valign="CENTER" height="32" row="0" col="2"/>
        <cl:group class="session" clipcontent="false">
          <cl:flowlayoutdata width="124px" height="32px" autosize="none"/>
          <cl:output id="optSession" class="session-time" fieldLabel="세션 남은 시간" tooltip="세션 남은 시간" value="60:00">
            <cl:formdata row="0" col="0"/>
          </cl:output>
          <cl:button id="btnSessionExt" class="ghost" tooltip="세션 연장" value="연장">
            <cl:listener name="click" handler="onBtnSessionExtClick"/>
            <cl:formdata valign="CENTER" height="24" row="0" col="1"/>
          </cl:button>
          <cl:formlayout scrollable="false" hspace="6px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="44" unit="PIXEL"/>
          </cl:formlayout>
        </cl:group>
        <cl:button id="btnAlarm" class="kt-ico bell" fieldLabel="알림" tooltip="알림" value="" icon="0">
          <cl:listener name="click" handler="onBtnAlarmClick"/>
          <cl:expbind property="class" category="CLASS" expression="&quot;kt-ico bell&quot; + (#dsNotiMsg.findAllRow(&quot;READ_YN != 'Y'&quot;).length > 0 ? &quot; active&quot; : &quot;&quot;)"/>
          <cl:flowlayoutdata width="32px" height="32px" autosize="none"/>
        </cl:button>
        <cl:group id="grpUser" class="user">
          <cl:flowlayoutdata width="100px" height="32px" autosize="width"/>
          <cl:output class="name" displayexp="text + &quot; 님&quot;">
            <cl:datamapbind property="value" datacontrolid="dmUserInfo" columnname="USER_NM"/>
            <cl:verticaldata width="100px" height="16px"/>
          </cl:output>
          <cl:output class="department">
            <cl:datamapbind property="value" datacontrolid="dmUserInfo" columnname="DEPT_NM"/>
            <cl:verticaldata width="100px" height="16px"/>
          </cl:output>
          <cl:verticallayout scrollable="false" spacing="0" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
        </cl:group>
        <cl:radiobutton id="rdbTheme" class="theme-toggle" fieldLabel="화면 모드" value="light" hspacing="0" vspacing="0">
          <cl:listener name="selection-change" handler="onRdbThemeSelectionChange"/>
          <cl:flowlayoutdata width="57px" height="32px" autosize="width"/>
          <cl:item label="" value="light"/>
          <cl:item label="" value="high-contrast"/>
          <cl:itemstyle>
            <cl:expbind property="class" category="CLASS" expression="value"/>
          </cl:itemstyle>
        </cl:radiobutton>
        <cl:button id="btnCustom" class="kt-ico setting" fieldLabel="환경설정" tooltip="환경설정" value="" icon="0">
          <cl:listener name="click" handler="onButtonClick5"/>
          <cl:flowlayoutdata width="32px" height="32px" autosize="none"/>
        </cl:button>
        <cl:button id="btnLogout" class="kt-ico logout" fieldLabel="로그아웃" tooltip="로그아웃" value="" icon="0">
          <cl:listener name="click" handler="onBtnLogoutClick"/>
          <cl:flowlayoutdata width="32px" height="32px" autosize="none"/>
        </cl:button>
        <cl:flowlayout hspacing="10" vspacing="0" halign="right" valign="middle"/>
      </cl:group>
      <cl:formlayout scrollable="false" hspace="24px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="330" unit="PIXEL" autoSizing="false" syncminlength="true"/>
        <cl:columns length="1" unit="FRACTION"/>
        <cl:columns length="470" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      </cl:formlayout>
    </cl:group>
    <cl:group id="grpGnb" class="header gnb-bar" visible="false" clipcontent="false">
      <cl:xylayoutdata top="52px" right="0px" left="0px" height="40px" horizontalAnchor="BOTH" verticalAnchor="TOP"/>
      <cl:navigationbar id="ngb" filterexp="UP_MENU_ID == null || UP_MENU_ID == &quot;&quot;" baritemspacing="32" barscrollbuttonposition="none">
        <cl:listener name="item-click" handler="onNgbItemClick"/>
        <cl:formdata row="0" col="0"/>
        <cl:menuitemset datasetid="dsAllMenu" label="MENU_NM" value="MENU_ID" parent="UP_MENU_ID"/>
      </cl:navigationbar>
      <cl:formlayout scrollable="false" hspace="12px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
    <cl:group id="grpBody" clipcontent="false">
      <cl:xylayoutdata top="52px" right="0px" bottom="0px" left="0px" horizontalAnchor="BOTH" verticalAnchor="BOTH"/>
      <cl:notifier id="notifier" scope="app" delay="7000" animation="fadein" close="true" successdelay="7000" successclose="true" infodelay="7000" infoclose="true" warningdelay="7000" warningclose="true" dangerdelay="7000" dangerclose="true">
        <cl:xylayoutdata right="10px" bottom="5px" left="10px" height="36px" horizontalAnchor="BOTH" verticalAnchor="BOTTOM"/>
      </cl:notifier>
      <cl:mdifolder id="mdiCn" class="mdi-content" clipcontent="false" childcombinatorclass="content" headerarrowposition="right" headercheckable="true" item-spacing="8" item-dragging-mode="internal">
        <cl:listener name="close" handler="onMdiCnClose"/>
        <cl:listener name="tabheader-click" handler="onMdiCnTabheaderClick"/>
        <cl:listener name="tabheader-check" handler="onMdiCnTabheaderCheck"/>
        <cl:listener name="tabheader-uncheck" handler="onMdiCnTabheaderUncheck"/>
        <cl:listener name="selection-change" handler="onMdiCnSelectionChange"/>
        <cl:xylayoutdata top="0px" right="300px" bottom="0px" left="272px" horizontalAnchor="BOTH" verticalAnchor="BOTH"/>
        <cl:tabitem name="dashboard" selected="true" text="대시보드" closable="true" visible="false">
          <std:metadata>
            <std:property key="is-active-item" value="true"/>
          </std:metadata>
          <cl:embeddedapp id="eaHome" src="DashboardKt.clx">
            <std:metadata>
              <std:property key="locked" value="true"/>
            </std:metadata>
          </cl:embeddedapp>
        </cl:tabitem>
        <cl:group id="mdiBtnUtils" class="mdi-btn-wrap" clipcontent="false">
          <cl:headercontroldata width="266" position="right"/>
          <cl:button id="btnMdiList" class="list" value="목록" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
            <cl:listener name="click" handler="onBtnListClick"/>
            <cl:expbind property="tooltip" category="PROPERTY" expression="value"/>
            <cl:flowlayoutdata width="24px" height="24px" autosize="none"/>
          </cl:button>
          <cl:udc id="btnDiv" type="udc.com.udcComMdiDiv">
            <cl:flowlayoutdata width="24px" height="24px"/>
          </cl:udc>
          <cl:button comment="&lt;ROW>&#xA;&lt;r>E-NAME:&#xA;&lt;r>E-DOC:&#xA;&lt;r>E-PARAM:&#xA;&lt;r>E-RR-UI-NAME:&#xA;&lt;r>E-CALL-SRV-NAME:&#xA;&lt;r>E-REP:&#xA;&lt;r>E-REMARK:" id="btnMdiZoom" class="zoom" value="확대" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
            <cl:listener name="click" handler="onBtnZoomClick"/>
            <cl:expbind property="tooltip" category="PROPERTY" expression="value"/>
            <cl:flowlayoutdata width="24px" height="24px" autosize="none"/>
          </cl:button>
          <cl:button id="btnMdiRefresh" class="reset" value="새로고침" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
            <cl:listener name="click" handler="onBtnResetClick"/>
            <cl:expbind property="tooltip" category="PROPERTY" expression="value"/>
            <cl:flowlayoutdata width="24px" height="24px" autosize="none"/>
          </cl:button>
          <cl:button id="btnMdiClose" class="close" value="모두 닫기" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
            <cl:listener name="click" handler="onBtnCloseClick"/>
            <cl:expbind property="tooltip" category="PROPERTY" expression="value"/>
            <cl:flowlayoutdata width="24px" height="24px" autosize="none"/>
          </cl:button>
          <cl:button id="btnMdiWinOpen" class="pop" value="새창보기" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
            <cl:listener name="click" handler="onBtnNewWindowClick"/>
            <cl:expbind property="tooltip" category="PROPERTY" expression="value"/>
            <cl:flowlayoutdata width="24px" height="24px" autosize="none"/>
          </cl:button>
          <cl:button id="btnFullWindow" class="full" value="화면전체크기" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
