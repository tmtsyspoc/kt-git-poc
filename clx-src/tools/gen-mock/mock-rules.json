{
	"_comment": "위에서부터 순서대로 검사해 처음 일치하는 규칙을 적용한다. match 키: dataset / column / comment / columnOrComment (정규식, 대소문자 무시, 지정한 키는 모두 만족해야 함). gen.type: int, decimal, sequence, enum, yn, const, label, digits, koreanName, engName, phone, jumin, email, address, text, date, fromFile, pattern(# 숫자/A 대문자/a 소문자), commentLabel, commentEnum, commentHint(comment 괄호 안 값 목록 사용, 못 뽑으면 다음 규칙으로). comment 패턴은 괄호를 뺀 문구와 원문 둘 다 검사한다. 규칙이 없으면 comment 가 있는 문자열 컬럼은 '<comment> N', 그 외는 datatype 별 기본값을 쓴다. --rules 로 준 파일은 이 파일보다 먼저 적용된다.",
	"rules": [
		{ "name": "상담유형", "match": { "comment": "^상담유형$" },
			"gen": { "type": "enum", "values": ["LMS문구문의", "결제금액문의", "결제일문의", "계약문의", "고객정보변경", "연락처변경"] } },
		{ "name": "건수", "match": { "comment": "^건수$" }, "gen": { "type": "int", "min": 1, "max": 200 } },
		{ "name": "유형별 건수", "match": { "column": "^CONS_TYPE[0-9]+$" }, "gen": { "type": "int", "min": 0, "max": 50 } },
		{ "name": "시간대(09시~)", "match": { "column": "^TIME$" }, "gen": { "type": "sequence", "start": 9, "pad": 2, "suffix": "시" } },

		{ "name": "고객번호(마스터: 순번)", "match": { "column": "^custNo$" }, "gen": { "type": "sequence", "start": 1 } },
		{ "name": "고객번호(참조: 1~10)", "match": { "column": "^CUST_NO$" }, "gen": { "type": "int", "min": 1, "max": 10 } },
		{ "name": "계약번호", "match": { "columnOrComment": "^CON_NO$|^계약번호$" }, "gen": { "type": "digits", "length": 11 } },

		{ "name": "휴대전화", "match": { "column": "^(HP|MOBILE|CELL)$" }, "gen": { "type": "phone", "kind": "mobile" } },
		{ "name": "전화번호", "match": { "columnOrComment": "^(TEL|PHONE)$|^(인입)?전화번호$|^연락처$" }, "gen": { "type": "phone" } },

		{ "name": "생년월일", "match": { "columnOrComment": "^birth|생년월일" },
			"gen": { "type": "date", "from": "1950-01-01", "to": "2005-12-31", "format": "yyyyMMdd" } },
		{ "name": "일시", "match": { "columnOrComment": "_DT$|DATETIME$|일시$" },
			"gen": { "type": "date", "from": "2023-01-01", "to": "2025-12-31", "format": "yyyy.MM.dd HH:mm:ss" } },
		{ "name": "일자", "match": { "columnOrComment": "DATE$|일자$" },
			"gen": { "type": "date", "from": "2023-01-01", "to": "2025-12-31", "format": "yyyyMMdd" } },

		{ "name": "금액", "match": { "columnOrComment": "^(AMOUNT|AMT)$|_(AMOUNT|AMT)$|^금액$" },
			"gen": { "type": "int", "min": 1000, "max": 10000000, "step": 10 } },

		{ "name": "[comment] 상품명 (이름 규칙의 Nm$ 보다 먼저)", "match": { "comment": "상품명|상품이름|보험명" },
			"gen": { "type": "enum", "unique": true, "values": ["실손의료보험", "정기보험", "연금저축보험", "어린이보험", "운전자보험", "종신보험", "암보험", "치아보험", "저축보험", "건강보험"] } },
		{ "name": "[comment] 부서", "match": { "comment": "부서|팀명|조직" }, "gen": { "type": "enum", "unique": true, "values": ["고객지원팀", "영업1팀", "영업2팀", "보상팀", "IT운영팀"] } },
		{ "name": "[comment] 회사/기관", "match": { "comment": "회사|기관|업체|거래처|법인명" }, "gen": { "type": "enum", "unique": true, "values": ["토마토상사", "한빛전자", "새봄물산", "푸른산업", "샘터유통"] } },

		{ "name": "영문명", "match": { "columnOrComment": "^engNm$|영문" }, "gen": { "type": "engName" } },
		{ "name": "이름", "match": { "columnOrComment": "(Nm|_NM)$|^(상담사|수령인|성명|이름|고객명)$" }, "gen": { "type": "koreanName" } },
		{ "name": "주민번호(가짜, 체크섬 불일치)", "match": { "columnOrComment": "^jumin$|주민(등록)?번호" }, "gen": { "type": "jumin" } },
		{ "name": "Y/N", "match": { "columnOrComment": "(Yn|_YN)$|여부$" }, "gen": { "type": "yn" } },
		{ "name": "나이", "match": { "columnOrComment": "^age$|^나이$" }, "gen": { "type": "int", "min": 18, "max": 80 } },

		{ "name": "국가(공통코드)", "match": { "column": "^nation$" },
			"gen": { "type": "fromFile", "file": "data/comCdList.json", "path": "DS_COM_CD", "field": "value", "fallback": ["1", "2", "3", "4", "5"] } },
		{ "name": "직업", "match": { "column": "^job$" }, "gen": { "type": "enum", "values": ["value1", "value2", "value3"] } },
		{ "name": "지급방법", "match": { "columnOrComment": "^PAY_WAY$|^지급방법$" }, "gen": { "type": "enum", "values": ["계좌이체", "현금", "카드", "수표"] } },
		{ "name": "지급사유", "match": { "columnOrComment": "^PAY_RSN$|^지급사유$" }, "gen": { "type": "enum", "values": ["연금지급", "보험금지급", "환급금지급", "만기지급"] } },

		{ "name": "콤보 label(항목1, 항목2…)", "match": { "column": "^label$" }, "gen": { "type": "sequence", "start": 1, "prefix": "항목" } },
		{ "name": "콤보 value(1, 2…) - label 과 같은 행끼리 짝", "match": { "column": "^value$" }, "gen": { "type": "sequence", "start": 1 } },
		{ "name": "이메일", "match": { "columnOrComment": "EMAIL|이메일" }, "gen": { "type": "email" } },
		{ "name": "우편번호", "match": { "columnOrComment": "ZIP|우편번호" }, "gen": { "type": "digits", "length": 5 } },
		{ "name": "주소", "match": { "columnOrComment": "ADDR|^주소$" }, "gen": { "type": "address" } },
		{ "name": "내용/비고", "match": { "columnOrComment": "DESC$|내용$|비고$|^MEMO$|^REMARK$" }, "gen": { "type": "text" } },

		{ "name": "[comment 힌트] 괄호 안 값 목록 (Y/N, 1:개인/2:법인 …)", "match": { "comment": "[(\\[{（].+[)\\]}）]" }, "gen": { "type": "commentHint" } },

		{ "name": "[comment] 사람 이름", "match": { "comment": "고객명|성명|이름|사원명|직원명|담당자|상담사|수령인|작성자|등록자|수정자|사용자명|신청인|가입자|계약자|피보험자|대표자" }, "gen": { "type": "koreanName" } },
		{ "name": "[comment] 은행", "match": { "comment": "은행" }, "gen": { "type": "enum", "values": ["가나은행", "다라은행", "마바은행", "사아은행"] } },
		{ "name": "[comment] 성별", "match": { "comment": "성별" }, "gen": { "type": "enum", "values": ["남", "여"] } },
		{ "name": "[comment] 결혼", "match": { "comment": "결혼|혼인" }, "gen": { "type": "enum", "values": ["기혼", "미혼"] } },
		{ "name": "[comment] 직업", "match": { "comment": "직업|직종" }, "gen": { "type": "enum", "values": ["회사원", "자영업", "공무원", "전문직", "주부", "학생"] } },
		{ "name": "[comment] 상태", "match": { "comment": "상태" }, "gen": { "type": "enum", "values": ["정상", "대기", "완료", "취소", "해지"] } },
		{ "name": "[comment] 결과", "match": { "comment": "결과" }, "gen": { "type": "enum", "values": ["성공", "실패", "보류"] } },
		{ "name": "[comment] 등급", "match": { "comment": "등급" }, "gen": { "type": "enum", "values": ["A", "B", "C", "D"] } },
		{ "name": "[comment] 채널", "match": { "comment": "채널" }, "gen": { "type": "enum", "values": ["콜센터", "모바일", "웹", "지점", "대리점"] } },
		{ "name": "[comment] 직급", "match": { "comment": "직급|직책" }, "gen": { "type": "enum", "unique": true, "values": ["사원", "대리", "과장", "차장", "부장"] } },
		{ "name": "[comment] 전일대비부호(1~5)", "match": { "comment": "전일대비부호" }, "gen": { "type": "enum", "values": ["1", "2", "3", "4", "5"] } },

		{ "name": "[comment] 휴대폰", "match": { "comment": "휴대폰|핸드폰|휴대전화|모바일" }, "gen": { "type": "phone", "kind": "mobile" } },
		{ "name": "[comment] 전화/연락처/팩스", "match": { "comment": "전화|연락처|팩스" }, "gen": { "type": "phone" } },
		{ "name": "[comment] 이메일", "match": { "comment": "이메일|e-?mail" }, "gen": { "type": "email" } },
		{ "name": "[comment] 상세주소", "match": { "comment": "상세주소" }, "gen": { "type": "pattern", "pattern": "###동 ###호" } },
		{ "name": "[comment] 주소", "match": { "comment": "주소" }, "gen": { "type": "address" } },
		{ "name": "[comment] 우편번호", "match": { "comment": "우편" }, "gen": { "type": "digits", "length": 5 } },
		{ "name": "[comment] 사업자번호", "match": { "comment": "사업자(등록)?번호" }, "gen": { "type": "pattern", "pattern": "###-##-#####" } },
		{ "name": "[comment] 계좌번호", "match": { "comment": "계좌번호?" }, "gen": { "type": "pattern", "pattern": "###-######-#####" } },
		{ "name": "[comment] 카드번호", "match": { "comment": "카드번호" }, "gen": { "type": "pattern", "pattern": "####-####-####-####" } },
		{ "name": "[comment] 차량번호", "match": { "comment": "차량번호" }, "gen": { "type": "pattern", "pattern": "##가####" } },
		{ "name": "[comment] 순번/순서", "match": { "comment": "순번|순서|일련" }, "gen": { "type": "sequence", "start": 1 } },
		{ "name": "[comment] 아이디", "match": { "comment": "아이디|^ID$|사용자ID" }, "gen": { "type": "sequence", "start": 1, "prefix": "user", "pad": 4 } },
		{ "name": "[comment] 코드", "match": { "comment": "코드$" }, "gen": { "type": "sequence", "start": 1, "prefix": "CD", "pad": 3 } },
		{ "name": "[comment] 번호", "match": { "comment": "번호$" }, "gen": { "type": "digits", "length": 8 } },
		{ "name": "[comment] URL", "match": { "comment": "URL|홈페이지|링크" }, "gen": { "type": "enum", "values": ["https://example.com/a", "https://example.com/b", "https://example.org/c"] } },

		{ "name": "[comment] 호가/시세", "match": { "comment": "호가$|상한가|하한가|현재가|체결가|종가|시가|고가|저가" }, "gen": { "type": "int", "min": 1000, "max": 100000, "step": 50 } },
		{ "name": "[comment] 잔량/거래량/누적", "match": { "comment": "잔량|거래량|거래대금|누적" }, "gen": { "type": "int", "min": 0, "max": 1000000 } },
		{ "name": "[comment] 체결강도", "match": { "comment": "체결강도" }, "gen": { "type": "decimal", "min": 0, "max": 200, "scale": 2 } },
		{ "name": "[comment] 금액류", "match": { "comment": "금액|요금|보험료|납입료|잔액|한도|수수료|급여|단가|가격|비용|합계|총액|액$" }, "gen": { "type": "int", "min": 1000, "max": 10000000, "step": 10 } },
		{ "name": "[comment] 건수/횟수/수량", "match": { "comment": "건수|횟수|수량|인원|개수" }, "gen": { "type": "int", "min": 0, "max": 100 } },
		{ "name": "[comment] 비율", "match": { "comment": "비율|[율률]$|퍼센트" }, "gen": { "type": "decimal", "min": 0, "max": 100, "scale": 1 } },
		{ "name": "[comment] 점수", "match": { "comment": "점수|평점|만족도" }, "gen": { "type": "int", "min": 0, "max": 100 } },
		{ "name": "[comment] 연령", "match": { "comment": "연령" }, "gen": { "type": "int", "min": 18, "max": 80 } },
		{ "name": "[comment] 기간", "match": { "comment": "기간|개월" }, "gen": { "type": "int", "min": 1, "max": 60 } },

		{ "name": "[comment] ○○일(날짜)", "match": { "comment": "(가입|시작|종료|만료|만기|등록|수정|기준|납입|결제|발급|접수|처리|해지|계약|청구|지급|상담|신청|승인|취소|변경|작성|발생|출금|입금)일(자)?$|날짜" },
			"gen": { "type": "date", "from": "2023-01-01", "to": "2025-12-31", "format": "yyyyMMdd" } },
		{ "name": "[comment] 년월", "match": { "comment": "년월$|기준월" }, "gen": { "type": "date", "from": "2023-01-01", "to": "2025-12-31", "format": "yyyyMM" } },
		{ "name": "[comment] 연도", "match": { "comment": "연도$|년도$" }, "gen": { "type": "date", "from": "2020-01-01", "to": "2025-12-31", "format": "yyyy" } },
		{ "name": "[comment] 시각", "match": { "comment": "시각$|시간$" }, "gen": { "type": "date", "from": "2025-01-01", "to": "2025-12-31", "format": "HH:mm:ss" } },

		{ "name": "[comment] 제목", "match": { "comment": "제목|타이틀|안건명|메시지" }, "gen": { "type": "text" } },
		{ "name": "[comment] 내용/사유/설명", "match": { "comment": "내용|사유|비고|메모|설명|상세|의견|요청" }, "gen": { "type": "text" } },
		{ "name": "[comment] 여부/유무", "match": { "comment": "여부|유무$" }, "gen": { "type": "yn" } },
		{ "name": "[comment] 구분/유형/종류 (구분1~3)", "match": { "comment": "구분|유형|종류|분류|타입|type" }, "gen": { "type": "commentEnum", "count": 3 } }
	]
}
