{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "pum",
	"description": "PUM 파일 스키마",
	"type": "object",
	"properties": {
		"title": {
			"type": "string",
			"description": "화면의 제목"
		},
		"subTitle": {
			"type": "string",
			"description": "화면의 부제목"
		},
		"description": {
			"type": "string",
			"description": "사용자에게 표시될 화면 설명 텍스트"
		},
		"comment": {
			"type": "string",
			"description": "화면에 대한 개발자용 설명"
		},
		"referenceDesign": {
			"type": "string",
			"description": "이 설계가 참조한 원본 템플릿 이름. CLX 생성 시 templates 폴더의 동명 JS 파일을 결과 스크립트로 재사용하는 데 사용됩니다."
		},
		"contents": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/anyComponent"
			},
			"description": "화면이 표시할 콘텐츠 목록"
		},
		"actions": {
			"$ref": "#/definitions/actions",
			"description": "화면에서 제공되는 액션들을 기술합니다."
		},
		"meta": {
			"type": "object",
			"description": "임의의 메타데이터"
		}
	},
	"additionalProperties": false,
	"definitions": {
		"compose": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "compose",
					"description": "두 개 이상의 다른 구역들을 하나의 개념 구역으로 묶기 위해 사용합니다. 단일 구역을 감싸는 용도로는 사용 불가하며 화면 복잡도를 낮추기 위해 사용을 가급적 자제합니다."
				},
				"title": {
					"$ref": "#/definitions/title"
				},
				"subTitle": {
					"$ref": "#/definitions/subTitle"
				},
				"subject": {
					"type": "string"
				},
				"description": {
					"$ref": "#/definitions/description"
				},
				"comment": {
					"$ref": "#/definitions/comment"
				},
				"layout": {
					"type": "string",
					"enum": [
						"vertical",
						"horizontal",
						"tab"
					],
					"description": "하위 구역 배치 방법을 지정합니다. 생략하는 경우 기본값은 'vertical'이며, 사용자가 명시적으로 요청한 경우에만 'horizontal'이나 'tab'을 사용합니다."
				},
				"contents": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/anyComponent"
					},
					"description": "구역에 포함될 콘텐츠들을 정의합니다."
				},
				"actions": {
					"$ref": "#/definitions/actions"
				},
				"meta": {
					"type": "object",
					"description": "임의의 메타데이터"
				}
			},
			"additionalProperties": false,
			"required": [
				"type",
				"contents"
			]
		},
		"field-set": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "field-set",
					"description": "한 개의 정보 엔티티에 대하여, 사용자가 정보를 열람, 편집, 입력할 수 있도록 보조하는 필드들의 구역입니다."
				},
				"title": {
					"$ref": "#/definitions/title"
				},
				"subTitle": {
					"$ref": "#/definitions/subTitle"
				},
				"subject": {
					"type": "string"
				},
				"purpose": {
					"enum": [
						"search",
						"create",
						"read",
						"modify"
					],
					"description": "해당 구역이 사용자에게 제공되는 목적을 나타냅니다. 'search'인 경우 해당 구역에서 검색 및 초기화 기능이 제공되어야 합니다."
				},
				"description": {
					"$ref": "#/definitions/description"
				},
				"comment": {
					"$ref": "#/definitions/comment"
				},
				"fields": {
					"$ref": "#/definitions/fields"
				},
				"actions": {
					"$ref": "#/definitions/actions"
				},
				"meta": {
					"type": "object",
					"description": "임의의 메타데이터"
				}
			},
			"additionalProperties": false,
			"required": [
				"type",
				"fields"
			]
		},
		"data-grid": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "data-grid",
					"description": "동일한 스킴을 가진 정보 엔티티들이 반복하여 배열되는 테이블이나 그리드 구역입니다."
				},
				"title": {
					"$ref": "#/definitions/title"
				},
				"subTitle": {
					"$ref": "#/definitions/subTitle"
				},
				"subject": {
					"type": "string"
				},
				"purpose": {
					"enum": [
						"read",
						"modify"
					],
					"description": "읽기 전용 그리드('read')인지 편집 가능한 그리드('modify')인지 구역의 목적을 지정합니다."
				},
				"description": {
					"$ref": "#/definitions/description"
				},
				"comment": {
					"$ref": "#/definitions/comment"
				},
				"fields": {
					"$ref": "#/definitions/fields"
				},
				"actions": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/action"
					},
					"description": "구역에서 제공되는 액션들을 기술 합니다."
				},
				"meta": {
					"type": "object",
					"description": "임의의 메타데이터"
				}
			},
			"additionalProperties": false,
			"required": [
				"type",
				"fields"
			]
		},
		"media": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"const": "media",
					"description": "미디어 콘텐츠가 표시되는 영역을 나타냅니다."
				},
				"title": {
					"$ref": "#/definitions/title"
				},
				"subTitle": {
					"$ref": "#/definitions/subTitle"
				},
				"subject": {
					"type": "string"
				},
				"kind": {
					"enum": [
						"image",
						"chart",
						"video",
						"text"
					],
					"description": "미디어 유형을 지정합니다. (이미지, 비디오, 텍스트 본문, 차트 등)"
				},
				"description": {
					"$ref": "#/definitions/description"
				},
				"comment": {
					"$ref": "#/definitions/comment"
				},
				"actions": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/action"
					},
					"description": "구역에서 제공되는 액션들을 기술 합니다."
				},
				"meta": {
					"type": "object",
					"description": "임의의 메타데이터"
				}
			},
			"additionalProperties": false,
			"required": [
				"type",
				"kind"
			]
		},
		"anyComponent": {
			"oneOf": [
				{
					"$ref": "#/definitions/compose"
				},
				{
					"$ref": "#/definitions/field-set"
				},
				{
					"$ref": "#/definitions/data-grid"
				},
				{
					"$ref": "#/definitions/media"
				}
			]
		},
		"actions": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/action"
			},
			"description": "구역에서 제공되는 액션들을 기술 합니다."
		},
		"action": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"label": {
							"type": "string",
							"description": "사용자에게 표시될 기능 이름"
						},
						"kind": {
							"type": "string",
							"enum": [
								"primary",
								"secondary",
								"danger"
							],
							"description": "액션의 종류입니다. 주사용은 'primary', 보조/일반은 'secondary'(생략 가능), 삭제 등 파괴적 기능은 'danger'를 지정합니다."
						},
						"description": {
							"$ref": "#/definitions/description"
						},
						"comment": {
							"$ref": "#/definitions/comment"
						},
						"meta": {
							"type": "object",
							"description": "임의의 메타데이터"
						}
					},
					"additionalProperties": false,
					"required": [
						"label"
					]
				},
				{
					"type": "object",
					"properties": {
						"label": {
							"type": "string"
						},
						"kind": {
							"type": "string",
							"const": "separator",
							"description": "실제 표시되는 액션이 아니라 여백 또는 구분자 역할임을 나타냅니다."
						},
						"meta": {
							"type": "object",
							"description": "임의의 메타데이터"
						}
					},
					"additionalProperties": false,
					"required": [
						"kind"
					]
				}
			]
		},
		"fields": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/field"
			},
			"description": "[!critical] 데이터 필드 목록. 반드시 1단계(Flat) 구조이어야 하며, 배열 안에 또 다른 fields를 중첩하는 것은 절대 금지됩니다."
		},
		"field": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"description": "필드 레이블"
				},
				"dataType": {
					"type": "string",
					"description": "필드의 데이터 유형(문자열, 숫자, boolean 등) 또는 연관 엔티티명. 적합한 타입이 없을 시 label 값을 사용합니다."
				},
				"required": {
					"type": "boolean",
					"description": "입력/조회 목적 등에서 필수적으로 입력해야 하는 필드인 경우 true를 지정. 그 외에는 속성을 생략합니다."
				},
				"visible": {
					"type": "boolean",
					"description": "화면에는 보이지 않지만 데이터로는 필요한 필드(PK, 코드값 등)인 경우 false를 지정. 그 외에는 속성을 생략합니다."
				},
				"description": {
					"$ref": "#/definitions/description"
				},
				"comment": {
					"$ref": "#/definitions/comment"
				},
				"fieldGroup": {
					"type": "string",
					"description": "그룹화된 필드인 경우, 그룹의 표시 레이블 텍스트"
				},
				"meta": {
					"type": "object",
					"description": "임의의 메타데이터"
				}
			},
			"additionalProperties": false,
			"required": [
				"label"
			]
		},
		"title": {
			"type": "string",
			"description": "구역의 제목"
		},
		"subTitle": {
			"type": "string",
			"description": "구역의 부제목"
		},
		"description": {
			"type": "string",
			"description": "사용자에게 표시될 설명 텍스트"
		},
		"comment": {
			"type": "string",
			"description": "화면 개발자가 참고 할 설명"
		}
	}
}